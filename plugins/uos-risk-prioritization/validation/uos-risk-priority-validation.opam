opam-version: "2.0"
synopsis: "UOS report-only risk prioritization validation"
description: "Local policy record, FMEA, dependency and lifecycle checks; no runtime authority."
maintainer: "UOS contributors"
authors: "UOS contributors"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.0"}
  "yojson" {>= "2.0.0"}
]
build: [["dune" "build" "validate.exe"]]
