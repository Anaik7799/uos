; Source-bound transition abstraction. No code extraction/admission claim.
(set-logic QF_LIRA)
(set-option :timeout 10000)
(declare-const transportValid Bool)
(declare-const pinMatches Bool)
(declare-const routeCredential Bool)
(declare-const isZenoh Bool)
(declare-const isHttp Bool)
(declare-const hmacValid Bool)
(declare-const bearerValid Bool)
(declare-const stdioMode Bool)
(declare-const mutexHeld Bool)
(declare-const uncertain Bool)
(define-fun authorized () Bool
  (and transportValid pinMatches routeCredential
       (=> isZenoh hmacValid) (=> isHttp bearerValid)))
(define-fun startSubscriber () Bool (and (not stdioMode) (not mutexHeld)))
(define-fun executeEffect () Bool (and authorized (not uncertain)))
; Block1: executable authorized witness, deliberately satisfiable.
(push)
(assert transportValid)
(assert pinMatches)
(assert routeCredential)
(assert isZenoh)
(assert hmacValid)
(assert (not isHttp))
(assert (not uncertain))
(assert executeEffect)
(check-sat)
(get-value (authorized executeEffect))
(pop)
; Block2: disjunction of forbidden transition counterexamples.
(push)
(assert (or (and executeEffect (not authorized))
            (and executeEffect isZenoh (not hmacValid))
            (and executeEffect isHttp (not bearerValid))
            (and executeEffect (not pinMatches))
            (and startSubscriber stdioMode)
            (and startSubscriber mutexHeld)
            (and executeEffect uncertain)))
(check-sat)
(pop)
; Block3: arithmetic identity and conditional contractive-energy bounds.
(declare-const V Real)
(declare-const nextV Real)
(declare-const alpha Real)
(push)
(assert (>= V 0))
(assert (> alpha 0))
(assert (<= alpha 1))
; Fixed alpha keeps this a linear arithmetic problem; alpha=48/49 from reviews.
(assert (= alpha (/ 48.0 49.0)))
(assert (= nextV (* (/ 1.0 49.0) V)))
(assert (or (not (= (+ 53 12 21 15) 101))
            (> nextV V) (< nextV 0)))
(check-sat)
(pop)
