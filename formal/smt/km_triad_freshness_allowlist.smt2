; Bounded independent counterexample checks for the disk projection contract.
(set-logic QF_LIA)
(set-option :timeout 3000)
(declare-const live_disk Bool)
(declare-const disk_bytes Int)
(declare-const served_bytes Int)
(declare-const allowed Bool)
(declare-const var_path Bool)
(declare-const jj_path Bool)
(declare-const symlink Bool)
(declare-const nlinks Int)
(declare-const status Int)
(declare-const soft404 Bool)
(declare-const no_store Bool)
(declare-const sha_matches Bool)
(declare-const accepted Bool)
(declare-const canonical_missing Bool)
(declare-const healthy Bool)
(assert (=> live_disk (= served_bytes disk_bytes)))
(assert (=> (or var_path jj_path symlink (> nlinks 1) (not allowed)) (= status 403)))
(assert (= accepted (and (= status 200) (not soft404) no_store sha_matches)))
(assert (= healthy (not canonical_missing)))
; Satisfiable control: a real safe successful disk read is possible.
(push)
(assert (and live_disk allowed (not var_path) (not jj_path) (not symlink) (= nlinks 1) (= status 200) (not soft404) no_store sha_matches (not canonical_missing) accepted healthy))
(check-sat)
(pop)
(push)
(assert (and live_disk (not (= served_bytes disk_bytes))))
(check-sat)
(pop)
(push)
(assert (and (= status 200) (or var_path jj_path symlink (> nlinks 1))))
(check-sat)
(pop)
(push)
(assert (and accepted soft404))
(check-sat)
(pop)
(push)
(assert (and canonical_missing healthy))
(check-sat)
(pop)
