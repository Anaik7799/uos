/-
# Ruliad.Core — abstract rewriting, confluence, causal invariance

The honest mathematical core of "the ruliad". A rule system is a relation; a
multiway graph is its reflexive-transitive closure; **causal invariance is
exactly confluence**, and that identification is what makes the Wolfram-model
vocabulary provable rather than evocative.

Reused from Mathlib (`Mathlib/Logic/Relation.lean`):
  `Relation.ReflTransGen`, `Relation.Join`, `Relation.ReflGen`,
  `Relation.church_rosser`, `ReflTransGen.cases_head`, `ReflTransGen.trans`.

Added here because Mathlib does **not** have it: Newman's lemma. Mathlib's
`church_rosser` needs the *strong* diamond (`ReflGen` on one side), which is
strictly stronger than local confluence; the local-confluence + termination
route is the one a bounded per-rule-pair check can actually discharge.

References: Newman (1942); Huet, *Confluent Reductions* (1980); Baader & Nipkow,
*Term Rewriting and All That* (1998) Thm 2.1.5 / 2.7.2. Independent Lean 4
precedent (read for comparison, not vendored): `Arthur742Ramos/Metatheory`
(MIT) `Metatheory/Rewriting/Newman.lean`.
-/
import Mathlib.Logic.Relation
import Mathlib.Order.WellFounded

namespace Ruliad

open Relation

variable {α : Type*} {R : α → α → Prop}

/-! ## Multiway reachability -/

/-- One state evolves to another in zero or more rule applications. This is the
edge relation of the multiway graph, closed under composition. -/
abbrev Steps (R : α → α → Prop) : α → α → Prop := ReflTransGen R

/-- Two states can be brought back together. -/
def Joinable (R : α → α → Prop) (a b : α) : Prop := Join (ReflTransGen R) a b

theorem Joinable.rfl (a : α) : Joinable R a a := ⟨a, .refl, .refl⟩

theorem Joinable.symm {a b : α} (h : Joinable R a b) : Joinable R b a :=
  let ⟨d, ha, hb⟩ := h; ⟨d, hb, ha⟩

/-- Divergence after **one** step each can be rejoined. Finitely checkable for a
finite rule set: it is a statement about critical pairs, not about runs. -/
def LocallyConfluent (R : α → α → Prop) : Prop :=
  ∀ a b c, R a b → R a c → Joinable R b c

/-- Divergence after **any** number of steps can be rejoined. This is causal
invariance: the observed outcome does not depend on the order or the slice. -/
def Confluent (R : α → α → Prop) : Prop :=
  ∀ a b c, Steps R a b → Steps R a c → Joinable R b c

/-- No infinite forward rewriting chain. -/
def Terminating (R : α → α → Prop) : Prop := WellFounded (fun x y => R y x)

/-- A state no rule applies to. -/
def NormalForm (R : α → α → Prop) (a : α) : Prop := ∀ b, ¬ R a b

theorem eq_of_normalForm {a b : α} (hn : NormalForm R a) (h : Steps R a b) : a = b := by
  induction h with
  | refl => rfl
  | tail _ hr ih => subst ih; exact absurd hr (hn _)

/-! ## Newman's lemma

The load-bearing theorem of this library. Local confluence is a bounded check
over rule pairs; confluence is a claim about the whole unbounded computation
space. Newman is the only thing that licenses the second from the first. -/

theorem newman (ht : Terminating R) (hlc : LocallyConfluent R) : Confluent R := by
  intro a
  refine WellFounded.induction ht
    (C := fun x => ∀ b c, Steps R x b → Steps R x c → Joinable R b c) a ?_
  intro x ih b c hxb hxc
  rcases ReflTransGen.cases_head hxb with rfl | ⟨x1, hx1, h1b⟩
  · exact ⟨c, hxc, .refl⟩
  rcases ReflTransGen.cases_head hxc with rfl | ⟨x2, hx2, h2c⟩
  · exact ⟨b, .refl, hxb⟩
  obtain ⟨d, h1d, h2d⟩ := hlc x x1 x2 hx1 hx2
  obtain ⟨e, hbe, hde⟩ := ih x1 hx1 b d h1b h1d
  obtain ⟨f, hcf, hef⟩ := ih x2 hx2 c e h2c (h2d.trans hde)
  exact ⟨f, hbe.trans hef, hcf⟩

/-- The strong diamond also gives confluence, via Mathlib's `church_rosser`.
Kept so both routes into `Confluent` are available to callers. -/
theorem confluent_of_diamond
    (h : ∀ a b c, R a b → R a c → ∃ d, R b d ∧ R c d) : Confluent R := by
  intro a b c hab hac
  exact church_rosser (fun a b c hb hc =>
    let ⟨d, hbd, hcd⟩ := h a b c hb hc
    ⟨d, ReflGen.single hbd, .single hcd⟩) hab hac

/-! ## What confluence buys: an observer-independent answer -/

/-- Unique normal forms. Two terminating observers of the same initial state
report the same result. -/
theorem unique_normalForm (hc : Confluent R) {a b c : α}
    (hab : Steps R a b) (hac : Steps R a c)
    (hb : NormalForm R b) (hc' : NormalForm R c) : b = c := by
  obtain ⟨d, hbd, hcd⟩ := hc a b c hab hac
  exact (eq_of_normalForm hb hbd).trans (eq_of_normalForm hc' hcd).symm

/-- A terminating, locally confluent system has observer-independent results.
This is the composite statement the rest of the library consumes. -/
theorem unique_normalForm_of_newman (ht : Terminating R) (hlc : LocallyConfluent R)
    {a b c : α} (hab : Steps R a b) (hac : Steps R a c)
    (hb : NormalForm R b) (hc : NormalForm R c) : b = c :=
  unique_normalForm (newman ht hlc) hab hac hb hc

/-- Convertibility collapses: the equivalence generated by the rules is exactly
joinability. Reuses Mathlib's `equivalence_join_reflTransGen`. -/
theorem joinable_equivalence
    (h : ∀ a b c, R a b → R a c → ∃ d, ReflGen R b d ∧ ReflTransGen R c d) :
    Equivalence (Join (ReflTransGen R)) :=
  equivalence_join_reflTransGen h

end Ruliad
