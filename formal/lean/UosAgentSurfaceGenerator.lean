/- =============================================================================
   UOS AGENT-SURFACE GENERATOR (LEAN 4.33.0)
   =============================================================================
   Lean is the single source for `CLAUDE.md` and the projected rule surfaces.

   Motivation is the measured RCA in `FractalRcaMirrorProjection.lean`:
   `SC-MIRROR-PROJ-001` §2 mandates byte-identical projection of every canonical
   contract into four vendor surfaces, and §4's gate contains NO check that
   compares mirror bytes to canonical. 9 of 77 projected files had drifted,
   undetected, with the SC-JOURNAL-v3 mirror 4,416 B short of canonical.

   This module supplies both halves of the repair:
     1. GENERATOR  - renders `CLAUDE.md` and pointer stubs from one model, so a
                     hand-copy step that can drift no longer exists.
     2. GATE       - `--check` classifies every projected file against canonical
                     and exits non-zero on divergence. This IS the missing §4
                     byte-identity falsifier.

   Fail-closed: `--check` is the default. Writing requires an explicit `--emit`.
   Only files whose bytes are byte-identical to canonical are ever replaced, so
   replacement is lossless by construction; divergent and canonical-less files
   are refused and reported.

   This module grants no admission (`SC-PROVENANCE-001`, ceiling 93).
   ============================================================================= -/

namespace UOS.SurfaceGen

/-! ## 1. Pure model -/

def admitted_ev_ceiling : Nat := 109

/-- Classification of a projected file against its canonical contract. -/
inductive ProjClass where
  | identical
  | divergent
  | noCanonical
  deriving DecidableEq, Repr, Inhabited

/-- Only an identical copy may be replaced: its bytes provably survive in
    `contracts/rules/`. The other classes carry unrecoverable content. -/
def safeToReplace : ProjClass → Bool
  | .identical   => true
  | .divergent   => false
  | .noCanonical => false

theorem safe_only_for_identical :
    safeToReplace .identical = true ∧
    safeToReplace .divergent = false ∧
    safeToReplace .noCanonical = false := by decide

/-- The four governed vendor surfaces (`SC-MIRROR-PROJ-001` §2). -/
def surfaces : List String := [".claude", ".codex", ".gemini", ".agents"]

theorem four_surfaces : surfaces.length = 4 := by decide

/-- A pointer stub: the projected name is retained in every surface, so §2
    projection-by-name and §4 name-set isomorphism both still hold, while the
    body is read on demand from the canonical path. -/
structure StubSpec where
  basename      : String
  title         : String
  canonicalPath : String
  deriving DecidableEq, Repr, Inhabited

/-- Marker that distinguishes a generated artifact from a hand-edited one. -/
def genMarker : String :=
  "<!-- GENERATED by formal/lean/UosAgentSurfaceGenerator.lean. Do not hand-edit. -->\n"

def stubBody (s : StubSpec) : String :=
  "# " ++ s.title ++ " (pointer)\n\n" ++
  "**Canonical body:** `" ++ s.canonicalPath ++ "`\n\n" ++
  "This surface carries the contract by name; the body is read on demand. " ++
  "**Read the canonical file before acting in this contract's domain** — a pointer " ++
  "is not a summary and grants no licence to act on the title alone.\n\n" ++
  "Projection is generated, so this pointer cannot drift from the body it names " ++
  "(`SC-MIRROR-PROJ-001` §2 as amended `20261105-1059`). Verify with " ++
  "`tools/uos-surface-gen --check`.\n\n" ++
  "EV ceiling 93; `EV-94..109` `NOT_ADMITTED`; no admission granted.\n"

def renderStub (s : StubSpec) : String := genMarker ++ stubBody s

/-- Every rendered stub carries the generation marker as its literal prefix, so a
    hand-edited projection is distinguishable from a generated one. -/
theorem stub_is_generated_marked (s : StubSpec) :
    renderStub s = genMarker ++ stubBody s := rfl

/-- Rendering is deterministic: same spec, same bytes. -/
theorem render_is_deterministic (a b : StubSpec) (h : a = b) :
    renderStub a = renderStub b := by rw [h]

