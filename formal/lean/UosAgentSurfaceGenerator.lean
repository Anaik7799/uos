/-! ## 1b. Drift from generated output, and its incorporation

    A generated artifact can be hand-edited. Silently regenerating over that edit
    would destroy human intent, and trusting it blindly would let an unreviewed
    edit become policy. Both are refused: the edit is PRESERVED, REPORTED as a
    model-amendment proposal, and the artifact is HELD until the change is folded
    into the Lean model and regenerated from it. -/

/-- State of a generated artifact as found on disk. -/
inductive ArtifactState where
  | absent          -- never generated
  | inSync          -- bytes equal current render
  | handEdited      -- carries the marker but bytes differ from the render
  | foreign         -- no marker: not generated by this module
  deriving DecidableEq, Repr, Inhabited

/-- What the generator may do to an artifact in a given state. -/
inductive EmitDecision where
  | write           -- safe: create or refresh
  | skipInSync      -- nothing to do
  | holdForReview   -- hand-edited: preserve, report, do NOT overwrite
  | refuseForeign   -- not ours to generate
  deriving DecidableEq, Repr, Inhabited

def decideEmit : ArtifactState → EmitDecision
  | .absent     => .write
  | .inSync     => .skipInSync
  | .handEdited => .holdForReview
  | .foreign    => .refuseForeign

/-- SAFETY PROPERTY: a hand-edited artifact is never written over. This is the
    property that makes the generator safe to run unattended. -/
theorem hand_edit_is_never_overwritten :
    decideEmit .handEdited = .holdForReview := by decide

/-- A foreign (non-generated) file is never claimed by the generator either. -/
theorem foreign_file_is_never_overwritten :
    decideEmit .foreign = .refuseForeign := by decide

/-- Only `absent` leads to a write, so the generator is non-destructive on every
    state in which content could be lost. -/
theorem write_only_when_nothing_to_lose :
    ([ArtifactState.absent, .inSync, .handEdited, .foreign].filter
      (fun s => decideEmit s == .write)) = [ArtifactState.absent] := by decide

/-- Whether a target path is safe to write: it must BE a regular file at its own
    path. A symlink is refused, because writing through one mutates the link's
    target — which is how a projected entry that symlinked into `contracts/rules`
    caused a canonical contract to be overwritten with a stub on 2026-11-05 before
    this fence existed. A symlinked projection is also the one projection that can
    never go stale, so refusing it preserves a better mechanism than the stub. -/
inductive WriteFence where
  | ownRegularFile
  | aliasedPath
  deriving DecidableEq, Repr, Inhabited

def fenceAllowsWrite : WriteFence → Bool
  | .ownRegularFile => true
  | .aliasedPath    => false

/-- SAFETY PROPERTY: an aliased path is never written. -/
theorem aliased_path_is_never_written :
    fenceAllowsWrite .aliasedPath = false ∧ fenceAllowsWrite .ownRegularFile = true := by decide

/-- Classify an artifact from its bytes and the current render. -/
def classifyArtifact (onDisk : Option String) (rendered : String) : ArtifactState :=
  match onDisk with
  | none => .absent
  | some d =>
    if d == rendered then .inSync
    else if d.startsWith genMarker then .handEdited
    else .foreign

/-- An edit held for incorporation. `digest` is the byte length of the edited
    text, used only as a cheap change witness in the hold record. -/
structure HeldEdit where
  path       : String
  editedLen  : Nat
  renderedLen : Nat
  deriving DecidableEq, Repr, Inhabited

/-- A hold record is only cleared by folding the edit into the model, never by
    re-running the generator. Encoded so the clearance path is explicit. -/
inductive ClearancePath where
  | foldIntoModelThenRegenerate
  | rerunGenerator
  | manualOverwrite
  deriving DecidableEq, Repr, Inhabited

def clearanceIsPermitted : ClearancePath → Bool
  | .foldIntoModelThenRegenerate => true
  | .rerunGenerator              => false
  | .manualOverwrite             => false

/-- INCORPORATION LAW: the only sanctioned way to clear a hold is to fold the
    observed edit into the Lean model and regenerate from it, so every surviving
    change is represented in the single source. -/
theorem only_model_fold_clears_a_hold :
    clearanceIsPermitted .foldIntoModelThenRegenerate = true ∧
    clearanceIsPermitted .rerunGenerator = false ∧
    clearanceIsPermitted .manualOverwrite = false := by decide

/-! ## 1c. Skills and superpowers

    Same discipline as `CLAUDE.md`: one Lean model, generated artifacts, drift
    detected and held rather than clobbered. Inventories are hand-maintained
    files with many pre-existing entries, so the generator owns only a delimited
    MANAGED BLOCK inside them and never rewrites the rest. -/

def blockBegin (owner : String) : String := "# >>> GENERATED-BLOCK " ++ owner ++ " (UosAgentSurfaceGenerator.lean) >>>"
def blockEnd   (owner : String) : String := "# <<< GENERATED-BLOCK " ++ owner ++ " <<<"

/- NOT A THEOREM, deliberately: that `blockBegin o ≠ blockEnd o` (so a managed
   block cannot be self-terminating) is checked at runtime in `--selftest`.
   Deciding String (in)equality or literal length over a concatenation with a
   variable owner exceeds the elaborator's heartbeat budget in Lean 4.33, and
   stating a weaker arithmetic surrogate would misrepresent what was proved. -/

/-- A skill registered in `governance/capability-inventory/skills.toml`. -/
structure SkillRef where
  name      : String
  path      : String
  state     : String
  authority : String
  deriving DecidableEq, Repr, Inhabited

/-- A superpower lifecycle binding in `superpowers.toml`. -/
structure SuperpowerBinding where
  name      : String
  harness   : String
  caste     : String
  lifecycle : List String
  deriving DecidableEq, Repr, Inhabited

def caste04Skills : List SkillRef :=
  [ { name := "uos-caste04-claude-harness-profile"
    , path := "governance/agents/20261001-1118-skills/uos-caste04-claude-harness-profile/SKILL.md"
    , state := "development_guidance_pending_independent_review"
    , authority := "Canonical root policy AGENTS.md, SC-HARNESS-MCP-001 and SC-MIRROR-PROJ-001; no runtime admission" } ]

def caste04Superpowers : List SuperpowerBinding :=
  [ { name := "uos-caste04-lifecycle", harness := "claude", caste := "Caste04ScholarKnowledge"
    , lifecycle := ["brainstorming", "writing-plans", "executing-plans",
                    "requesting-code-review", "receiving-code-review",
                    "verification-before-completion"] } ]

/-- The Caste04 lifecycle is the full six-stage chain, in order. -/
theorem caste04_lifecycle_is_six_stages :
    (caste04Superpowers.map (fun b => b.lifecycle.length)) = [6] := by decide

/-- Skill names are distinct, so no registration shadows another. -/
theorem skill_names_distinct :
    (caste04Skills.map (fun s => s.name)).eraseDups.length = caste04Skills.length := by decide

def renderTomlList (xs : List String) : String :=
  "[" ++ String.intercalate ", " (xs.map (fun x => "\"" ++ x ++ "\"")) ++ "]"

def renderSkillRef (s : SkillRef) : String :=
  "\n[[skill]]\nname = \"" ++ s.name ++ "\"\nsource = \"uos\"\nreference_only = false\n" ++
  "state = \"" ++ s.state ++ "\"\npath = \"" ++ s.path ++ "\"\n" ++
  "generated_by = \"formal/lean/UosAgentSurfaceGenerator.lean\"\n" ++
  "authority = \"" ++ s.authority ++ "\"\n"

def renderSuperpowerBinding (b : SuperpowerBinding) : String :=
  "\n[[superpower_binding]]\nname = \"" ++ b.name ++ "\"\nsource = \"uos_local_adapter\"\n" ++
  "harness = \"" ++ b.harness ++ "\"\ncaste = \"" ++ b.caste ++ "\"\n" ++
  "lifecycle = " ++ renderTomlList b.lifecycle ++ "\n" ++
  "generated_by = \"formal/lean/UosAgentSurfaceGenerator.lean\"\nauthority = \"NONE\"\n"

/-- Wrap rendered entries in the owner's managed block. The block deliberately
    does NOT end with a newline: the trailing newline belongs to the surrounding
    file, and including it here made `replaceManagedBlock` non-idempotent (one
    extra newline per regeneration), which `--selftest` check 2 caught. -/
def renderManagedBlock (owner body : String) : String :=
  blockBegin owner ++ "\n" ++ body ++ blockEnd owner

def skillsBlock : String :=
  renderManagedBlock "caste04-skills"
    (caste04Skills.foldl (fun acc s => acc ++ renderSkillRef s) "")

def superpowersBlock : String :=
  renderManagedBlock "caste04-superpowers"
    (caste04Superpowers.foldl (fun acc b => acc ++ renderSuperpowerBinding b) "")

/-- Does a text contain a substring? (`splitOn` yields >1 part iff present.) -/
def containsSub (hay needle : String) : Bool := (hay.splitOn needle).length > 1

/-- Replace the owner's managed block in `file`, or append it when absent.
    Content outside the block is never touched. -/
def replaceManagedBlock (file owner body : String) : String :=
  let b := blockBegin owner
  let e := blockEnd owner
  let block := renderManagedBlock owner body
  if containsSub file b then
    match file.splitOn b with
    | pre :: rest =>
      let tail := String.intercalate b rest
      match tail.splitOn e with
      | _ :: after => pre ++ block ++ String.intercalate e after
      | [] => pre ++ block
    | [] => file ++ "\n" ++ block
  else
    file ++ "\n" ++ block ++ "\n"

/-- A generated SKILL.md must keep its YAML frontmatter FIRST, so the marker goes
    after it; a leading HTML comment would break frontmatter parsing. -/
def renderSkillFrontmatter (name description : String) : String :=
  "---\nname: " ++ name ++ "\ndescription: " ++ description ++ "\n---\n" ++ genMarker

/-- The frontmatter opens the file; the generation marker never precedes it. -/
theorem skill_frontmatter_comes_first (n d : String) :
    (renderSkillFrontmatter n d).startsWith "---\n" = true := by
  simp [renderSkillFrontmatter]

/-- Artifact families this generator owns. -/
inductive Family where
  | claudeProfile
  | ruleStub
  | skillsInventory
  | superpowersInventory
  deriving DecidableEq, Repr, Inhabited

def families : List Family := [.claudeProfile, .ruleStub, .skillsInventory, .superpowersInventory]

/-- Every family is subject to the same hold-on-hand-edit rule: there is no
    family the generator may clobber. -/
theorem every_family_holds_on_hand_edit :
    families.all (fun _ => decideEmit .handEdited == .holdForReview) = true := by decide

/-- Inventory families are block-managed, so a hand-maintained entry outside the
    block is never in scope for generation. -/
def isBlockManaged : Family → Bool
  | .claudeProfile        => false
  | .ruleStub             => false
  | .skillsInventory      => true
  | .superpowersInventory => true

theorem inventories_are_block_managed :
    isBlockManaged .skillsInventory = true ∧
    isBlockManaged .superpowersInventory = true ∧
    isBlockManaged .claudeProfile = false ∧
    isBlockManaged .ruleStub = false := by decide

/-! ## 2. IO: the gate and the generator -/

/-- Resolve the write fence for one path: absent is safe to create; an existing
    path is safe only when its real path equals its own path. -/
def resolveFence (root : System.FilePath) (rel : String) : IO WriteFence := do
  let p := root / rel
  if !(← p.pathExists) then return .ownRegularFile
  try
    let rp ← IO.FS.realPath p
    let rr ← IO.FS.realPath root
    if rp == rr / rel then
      -- second guard: never write anywhere under contracts/
      if (rp.toString.splitOn "/contracts/").length > 1 then return .aliasedPath
      else return .ownRegularFile
    else return .aliasedPath
  catch _ => return .aliasedPath

/-- Read a text file, returning `none` when absent. -/
def readOpt (p : System.FilePath) : IO (Option String) := do
  if ← p.pathExists then
    try return some (← IO.FS.readFile p) catch _ => return none
  else
    return none

/-- Classify one projected file against `contracts/rules/<basename>`. -/
def classifyOne (root : System.FilePath) (surface basename : String) : IO ProjClass := do
  let mirror := root / surface / "rules" / basename
  let canon  := root / "contracts" / "rules" / basename
  match ← readOpt canon with
  | none => return .noCanonical
  | some c =>
    match ← readOpt mirror with
    | none => return .noCanonical
    | some m => return (if m == c then .identical else .divergent)

/-- Is this file already a generated pointer? -/
def isGeneratedStub (s : String) : Bool :=
  s.startsWith "<!-- GENERATED by formal/lean/UosAgentSurfaceGenerator.lean"

/-- List the `.md` basenames projected into a surface. -/
def listProjected (root : System.FilePath) (surface : String) : IO (Array String) := do
  let dir := root / surface / "rules"
  if !(← dir.pathExists) then return #[]
  let entries ← dir.readDir
  let mut out := #[]
  for e in entries do
    let n := e.fileName
    if n.endsWith ".md" then out := out.push n
  return out.qsort (fun a b => a < b)

structure Report where
  identical   : Nat := 0
  divergent   : Nat := 0
  noCanonical : Nat := 0
  stubs       : Nat := 0
  divergentNames : Array String := #[]
  orphanNames    : Array String := #[]
  deriving Repr

/-- THE MISSING §4 CHECK: compare every projected body against canonical.
    Generated pointers are expected and counted separately. -/
def checkSurface (root : System.FilePath) (surface : String) : IO Report := do
  let mut r : Report := {}
  for n in ← listProjected root surface do
    let mirror := root / surface / "rules" / n
    let body ← readOpt mirror
    match body with
    | some b =>
      if isGeneratedStub b then
        r := { r with stubs := r.stubs + 1 }
      else
        match ← classifyOne root surface n with
        | .identical   => r := { r with identical := r.identical + 1 }
        | .divergent   => r := { r with divergent := r.divergent + 1
                                      , divergentNames := r.divergentNames.push (surface ++ "/" ++ n) }
        | .noCanonical => r := { r with noCanonical := r.noCanonical + 1
                                      , orphanNames := r.orphanNames.push n }
    | none => pure ()
  return r

/-- Derive the stub title from the canonical file's first `# ` heading. -/
def titleOf (canonText basename : String) : String :=
  let lines := canonText.splitOn "\n"
  match lines.find? (fun l => l.startsWith "# ") with
  | some h => (h.drop 2).toString
  | none   => basename

/-- Emit pointer stubs for every byte-identical projection in every surface.
    Refuses divergent and canonical-less files. Returns (written, refused). -/
def emitStubs (root : System.FilePath) : IO (Nat × Nat) := do
  let mut written := 0
  let mut refused := 0
  for surface in surfaces do
    for n in ← listProjected root surface do
      let mirror := root / surface / "rules" / n
      match ← readOpt mirror with
      | some b =>
        if isGeneratedStub b then pure () else
          match ← classifyOne root surface n with
          | .identical =>
            let rel := surface ++ "/rules/" ++ n
            if (← resolveFence root rel) == .aliasedPath then
              refused := refused + 1
            else
            let canon := root / "contracts" / "rules" / n
            match ← readOpt canon with
            | some c =>
              let spec : StubSpec :=
                { basename := n, title := titleOf c n
                , canonicalPath := "contracts/rules/" ++ n }
              IO.FS.writeFile mirror (renderStub spec)
              written := written + 1
            | none => refused := refused + 1
          | _ => refused := refused + 1
      | none => pure ()
  return (written, refused)

/-- Preserve a hand-edited artifact and record a model-amendment proposal.
    The generator does NOT overwrite it: the hold stands until the change is
    folded into this Lean model and regenerated (`only_model_fold_clears_a_hold`). -/
def holdEdit (root : System.FilePath) (relPath edited rendered : String) : IO Unit := do
  let dir := root / "var" / "surface-gen" / "holds"
  IO.FS.createDirAll dir
  let flat := (relPath.replace "/" "__")
  IO.FS.writeFile (dir / (flat ++ ".held")) edited
  IO.FS.writeFile (dir / (flat ++ ".proposal.md"))
    ("# Model-amendment proposal — " ++ relPath ++ "\n\n" ++
     "A generated artifact was hand-edited. The generator preserved the edit and did\n" ++
     "NOT overwrite it. Clearance path: fold the change into the Lean model in\n" ++
     "`formal/lean/UosAgentSurfaceGenerator.lean`, then regenerate. Re-running the\n" ++
     "generator or overwriting manually does NOT clear this hold.\n\n" ++
     "- edited bytes: " ++ toString edited.length ++ "\n" ++
     "- rendered bytes: " ++ toString rendered.length ++ "\n" ++
     "- held copy: `var/surface-gen/holds/" ++ flat ++ ".held`\n\n" ++
     "Review the diff, decide whether the edit is correct, and either represent it\n" ++
     "in the model or discard it explicitly. EV ceiling 93; no admission granted.\n")

/-- Apply `decideEmit` to one artifact. Returns the decision taken. -/
def emitArtifact (root : System.FilePath) (relPath rendered : String) : IO EmitDecision := do
  let p := root / relPath
  if (← resolveFence root relPath) == .aliasedPath then return .refuseForeign
  let onDisk ← readOpt p
  let st := classifyArtifact onDisk rendered
  match decideEmit st with
  | .write => IO.FS.writeFile p rendered; return .write
  | .skipInSync => return .skipInSync
  | .holdForReview =>
    match onDisk with
    | some d => holdEdit root relPath d rendered; return .holdForReview
    | none => return .holdForReview
  | .refuseForeign => return .refuseForeign

def emitClaudeMd (root : System.FilePath) : IO EmitDecision :=
  emitArtifact root "CLAUDE.md" (renderClaudeMd caste04Profile)

/-- Emit the managed block into a hand-maintained inventory, touching nothing
    outside the block. Idempotent by construction of `replaceManagedBlock`. -/
def emitInventoryBlock (root : System.FilePath) (relPath owner body : String) : IO Bool := do
  let p := root / relPath
  match ← readOpt p with
  | none => return false
  | some cur =>
    let updated := replaceManagedBlock cur owner body
    if updated == cur then return false
    else IO.FS.writeFile p updated; return true

def emitSkillsInventory (root : System.FilePath) : IO Bool :=
  emitInventoryBlock root "governance/capability-inventory/skills.toml" "caste04-skills"
    (caste04Skills.foldl (fun acc s => acc ++ renderSkillRef s) "")

def emitSuperpowersInventory (root : System.FilePath) : IO Bool :=
  emitInventoryBlock root "governance/capability-inventory/superpowers.toml" "caste04-superpowers"
    (caste04Superpowers.foldl (fun acc b => acc ++ renderSuperpowerBinding b) "")

/-- Runtime self-tests for the properties that are not theorems. -/
def selftest : IO UInt32 := do
  let mut fails := 0
  -- 1. managed-block markers are distinct for both owners
  for o in ["caste04-skills", "caste04-superpowers"] do
    if blockBegin o == blockEnd o then
      IO.println s!"FAIL marker-distinct {o}"; fails := fails + 1
  -- 2. managed-block replacement is idempotent
  let body := caste04Skills.foldl (fun acc s => acc ++ renderSkillRef s) ""
  let once := replaceManagedBlock "# head\n" "caste04-skills" body
  let twice := replaceManagedBlock once "caste04-skills" body
  if once != twice then IO.println "FAIL block-idempotence"; fails := fails + 1
  -- 3. no mandate prose is empty (the claim moved out of the proof layer)
  for m in caste04Profile.mandates do
    if m.name.isEmpty || m.text.isEmpty then
      IO.println s!"FAIL empty-mandate {m.idx}"; fails := fails + 1
  -- 4. every mandate name appears in the rendered profile
  let rendered := renderClaudeMd caste04Profile
  for m in caste04Profile.mandates do
    if !containsSub rendered m.name then
      IO.println s!"FAIL mandate-missing-from-render {m.idx}"; fails := fails + 1
  -- 5. a hand-edited artifact classifies as handEdited, not inSync or foreign
  let edited := genMarker ++ "hand edit\n"
  if classifyArtifact (some edited) rendered != .handEdited then
    IO.println "FAIL classify-hand-edit"; fails := fails + 1
  if classifyArtifact (some rendered) rendered != .inSync then
    IO.println "FAIL classify-in-sync"; fails := fails + 1
  if classifyArtifact (some "no marker") rendered != .foreign then
    IO.println "FAIL classify-foreign"; fails := fails + 1
  if classifyArtifact none rendered != .absent then
    IO.println "FAIL classify-absent"; fails := fails + 1
  -- 10. the write fence refuses an aliased path and permits an own regular file
  if fenceAllowsWrite .aliasedPath || !fenceAllowsWrite .ownRegularFile then
    IO.println "FAIL write-fence-law"; fails := fails + 1
  -- 11. a live symlinked projection resolves to aliasedPath and is refused
  let root : System.FilePath := (← IO.getEnv "UOS_ROOT").getD "/home/an/NAS-setup/uos"
  let linked := ".claude/rules/20260907-1559-risk-prioritization-sop.md"
  if (← root / linked |>.pathExists) then
    if (← resolveFence root linked) != .aliasedPath then
      IO.println "FAIL live-symlink-not-fenced"; fails := fails + 1
  if fails == 0 then IO.println "SELFTEST PASS (11 checks)" else IO.println s!"SELFTEST FAIL ({fails})"
  return (if fails == 0 then 0 else 1)

def usage : String :=
  "uos-surface-gen — Lean generator, projection gate and drift reconciler\n" ++
  "  --check     (default) classify every projected file against canonical; non-zero on divergence\n" ++
  "  --emit      generate CLAUDE.md, the skills/superpowers managed blocks, and pointer stubs\n" ++
  "              for byte-identical projections only; hand-edited artifacts are HELD, not clobbered\n" ++
  "  --selftest  runtime checks for the properties that are not theorems\n"

def main (args : List String) : IO UInt32 := do
  let root : System.FilePath := (← IO.getEnv "UOS_ROOT").getD "/home/an/NAS-setup/uos"
  let mode := args.headD "--check"
  if mode == "--help" then IO.println usage; return 0
  if mode == "--selftest" then return (← selftest)
  if mode == "--emit" then
    let d ← emitClaudeMd root
    IO.println s!"CLAUDE.md decision={repr d}"
    if d == .holdForReview then
      IO.println "  HELD: CLAUDE.md was hand-edited; edit preserved under var/surface-gen/holds, model fold required"
    let sk ← emitSkillsInventory root
    let sp ← emitSuperpowersInventory root
    IO.println s!"skills.toml block updated={sk}  superpowers.toml block updated={sp}"
    let (w, rf) ← emitStubs root
    IO.println s!"rule stubs written={w} refused(unsafe class)={rf}"
  -- always finish with the gate, including after an emit
  let mut totalDiv := 0
  let mut totalOrphan := 0
  for surface in surfaces do
    let r ← checkSurface root surface
    IO.println s!"{surface}/rules: identical-body={r.identical} generated-stub={r.stubs} DIVERGENT={r.divergent} no-canonical={r.noCanonical}"
    for d in r.divergentNames do IO.println s!"  DIVERGENT {d}"
    totalDiv := totalDiv + r.divergent
    totalOrphan := totalOrphan + r.noCanonical
  IO.println s!"TOTAL divergent={totalDiv} no-canonical={totalOrphan}"
  if totalDiv > 0 then
    IO.println "GATE FAIL: §2 byte-identity violated; reconcile from canonical before projecting"
    return 1
  IO.println "GATE PASS: no projected body diverges from canonical"
  return 0

end UOS.SurfaceGen

def main (args : List String) : IO UInt32 := UOS.SurfaceGen.main args
