#!/bin/sh
# Wrapper for the OCaml gospel-lint. Builds on first use, then execs it.
set -e
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exe="$here/gospel_lint/_build/default/gospel_lint_cli.exe"
[ -x "$exe" ] || (cd "$here/gospel_lint" && dune build @default 2>/dev/null || dune build)
exec "$exe" "$@"
