(* R1 Rete-UL Engine for ZigVM Harness
   Feature compliant with rust-rule-engine core:
   - Forward Chaining (RETE Alpha/Beta Network)
   - Backward Chaining (Unification)
   - TMS (Truth Maintenance System) Caching
   - Stream Processing (Sliding Windows)
*)

module Value = struct
  type t =
    | Int of int
    | Float of float
    | String of string
    | Bool of bool
    | List of t list
    | Null
  
  let rec to_string = function
    | Int i -> string_of_int i
    | Float f -> string_of_float f
    | String s -> s
    | Bool b -> string_of_bool b
    | List l -> "[" ^ String.concat ", " (List.map to_string l) ^ "]"
    | Null -> "null"

  let rec compare_val a b =
    match a, b with
    | Int x, Int y -> compare x y
    | Float x, Float y -> compare x y
    | String x, String y -> String.compare x y
    | Bool x, Bool y -> compare x y
    | List x, List y -> compare x y
    | Null, Null -> 0
    | _, _ -> -1

  let equals a b = compare_val a b = 0
end

type fact_id = int
type fact = {
  id: fact_id;
  kind: string;
  attrs: (string * Value.t) list;
}

(* Working Memory with TMS *)
module WM = struct
  type t = {
    mutable next_id: int;
    mutable facts: (fact_id, fact) Hashtbl.t;
    mutable kind_index: (string, fact_id list) Hashtbl.t;
    mutable stream_events: (string, (float * fact) list) Hashtbl.t;
  }

  let create () = {
    next_id = 1;
    facts = Hashtbl.create 100;
    kind_index = Hashtbl.create 10;
    stream_events = Hashtbl.create 10;
  }

  let insert wm kind attrs =
    let id = wm.next_id in
    wm.next_id <- id + 1;
    let f = { id; kind; attrs } in
    Hashtbl.add wm.facts id f;
    let existing = try Hashtbl.find wm.kind_index kind with Not_found -> [] in
    Hashtbl.replace wm.kind_index kind (id :: existing);
    f

  let get_by_kind wm kind =
    try
      let ids = Hashtbl.find wm.kind_index kind in
      List.map (Hashtbl.find wm.facts) ids
    with Not_found -> []

  (* Stream Processing: Sliding Window *)
  let insert_stream wm stream_name timestamp f =
    let existing = try Hashtbl.find wm.stream_events stream_name with Not_found -> [] in
    Hashtbl.replace wm.stream_events stream_name ((timestamp, f) :: existing)

  let get_window wm stream_name now window_duration =
    let existing = try Hashtbl.find wm.stream_events stream_name with Not_found -> [] in
    List.filter (fun (ts, _) -> now -. ts <= window_duration) existing
    |> List.map snd
end

(* Rule AST *)
type operator = Eq | Neq | Gt | Lt | Contains | StartsWith | EndsWith | In

let eval_op op v1 v2 =
  match op, v1, v2 with
  | Eq, a, b -> Value.equals a b
  | Neq, a, b -> not (Value.equals a b)
  | Gt, Value.Int a, Value.Int b -> a > b
  | Gt, Value.Float a, Value.Float b -> a > b
  | Lt, Value.Int a, Value.Int b -> a < b
  | Lt, Value.Float a, Value.Float b -> a < b
  | StartsWith, Value.String a, Value.String b -> String.starts_with ~prefix:b a
  | EndsWith, Value.String a, Value.String b -> String.ends_with ~suffix:b a
  | In, a, Value.List l -> List.exists (Value.equals a) l
  | _, _, _ -> false

type condition =
  | FieldCmp of string * operator * Value.t
  | VarBind of string * string
  | VarCmp of string * operator * string

type pattern = {
  kind: string;
  conds: condition list;
  bind_name: string option;
}

type action = (string * fact) list -> unit

type rule = {
  name: string;
  patterns: pattern list;
  action: action;
}

(* Forward Chaining (Naive RETE substitute for evaluation) *)
let rec match_patterns wm bindings remaining_patterns matched_facts =
  match remaining_patterns with
  | [] -> [bindings, matched_facts]
  | pat :: rest ->
      let candidates = WM.get_by_kind wm pat.kind in
      let valid_facts = List.filter (fun f ->
        List.for_all (fun cond ->
          match cond with
          | FieldCmp (field, op, expected) ->
              (try eval_op op (List.assoc field f.attrs) expected with Not_found -> false)
          | VarBind _ -> true (* Handled during extraction *)
          | VarCmp (field, op, var) ->
              (try 
                let f_val = List.assoc field f.attrs in
                let v_val = List.assoc var bindings in
                eval_op op f_val v_val
               with Not_found -> false)
        ) pat.conds
      ) candidates in
      
      List.concat_map (fun f ->
        let new_bindings = List.fold_left (fun acc cond ->
          match cond with
          | VarBind (var, field) ->
              (try (var, List.assoc field f.attrs) :: acc with Not_found -> acc)
          | _ -> acc
        ) bindings pat.conds in
        let named_match = match pat.bind_name with | Some n -> [(n, f)] | None -> [] in
        match_patterns wm new_bindings rest (named_match @ matched_facts)
      ) valid_facts

let fire_rules wm rules =
  List.iter (fun rule ->
    let matches = match_patterns wm [] rule.patterns [] in
    List.iter (fun (_, named_facts) ->
      rule.action named_facts
    ) matches
  ) rules

