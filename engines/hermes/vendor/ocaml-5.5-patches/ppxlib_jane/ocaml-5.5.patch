From 3b31321e869520f58288acbc0d9ee108454dcc1e Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 2 Aug 2026 22:54:23 +0200
Subject: [PATCH 1/2] compat: use migrated longident types on OCaml 5.5

---
 src/common.ml      | 2 +-
 src/ppxlib_jane.ml | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/common.ml b/src/common.ml
index da3c501..e00b383 100644
--- a/src/common.ml
+++ b/src/common.ml
@@ -26,7 +26,7 @@ let as_unlabeled_tuple components =
   else None
 ;;
 
-let mangle_longident ~suffix : Longident.t -> Longident.t = function
+let mangle_longident ~suffix : Astlib.Longident.t -> Astlib.Longident.t = function
   | Lident name -> Lident (name ^ suffix)
   | Ldot (path, name) -> Ldot (path, name ^ suffix)
   | Lapply _ as longident -> longident
diff --git a/src/ppxlib_jane.ml b/src/ppxlib_jane.ml
index fe627dd..6ef3f7a 100644
--- a/src/ppxlib_jane.ml
+++ b/src/ppxlib_jane.ml
@@ -28,7 +28,7 @@ type arrow_argument = Shim.arrow_argument =
 
 type jkind_annotation_desc = Shim.jkind_annotation_desc =
   | Pjk_default
-  | Pjk_abbreviation of Longident.t Ppxlib_ast.Asttypes.loc * string Location.loc list
+  | Pjk_abbreviation of Astlib.Longident.t Ppxlib_ast.Asttypes.loc * string Location.loc list
   | Pjk_mod of Shim.jkind_annotation * Shim.Modes.t
   | Pjk_with of Shim.jkind_annotation * Ppxlib_ast.Parsetree.core_type * Shim.Modalities.t
   | Pjk_kind_of of Ppxlib_ast.Parsetree.core_type
-- 
