From 0ed2b21cc38456771b5a4cc70ccbb0fb8b58d1cf Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 2 Aug 2026 23:18:45 +0200
Subject: [PATCH 5/5] compat: limit constrained type mangling to packages

---
 expander/mangle.ml | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/expander/mangle.ml b/expander/mangle.ml
index f9d14df..96b197d 100644
--- a/expander/mangle.ml
+++ b/expander/mangle.ml
@@ -260,7 +260,14 @@ let t =
       | Ppat_any | Ppat_var _ | Ppat_alias _ -> super#pattern_desc suffix pattern_desc
       | Ppat_constraint (pat, typ, modes) ->
         let pat, pat_outcome = self#pattern suffix pat in
-        let typ, typ_outcome = self#option self#core_type suffix typ in
+        let typ, typ_outcome =
+          match typ with
+          | Some ({ ptyp_desc = Ptyp_package _; _ } as typ)
+            when not (Suffix.is_empty suffix) ->
+            let typ, outcome = self#core_type suffix typ in
+            Some typ, outcome
+          | _ -> typ, Did_not_mangle
+        in
         ( Ppxlib_jane.Shim.Pattern_desc.to_parsetree
             ~loc:pat.ppat_loc
             (Ppat_constraint (pat, typ, modes))
