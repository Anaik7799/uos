From c7c0869f83d7cfa03f45838edeeed1fa8afd11c0 Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 2 Aug 2026 23:00:10 +0200
Subject: [PATCH 3/4] compat: make heap and stack serializers explicit

---
 src/map.ml | 10 +++++++---
 src/set.ml | 10 +++++++---
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/src/map.ml b/src/map.ml
index 3d09bde..4d832b6 100644
--- a/src/map.ml
+++ b/src/map.ml
@@ -3970,13 +3970,17 @@ module type Equal_m = sig end
 module type Hash_fold_m = Hasher.S
 module type Globalize_m = sig end
 
-let%template[@alloc a @ m = (heap_global, stack_local)] sexp_of_m__t
+let sexp_of_m__t (type k) (module K : Sexp_of_m with type t = k) sexp_of_v t =
+  sexp_of_t K.sexp_of_t sexp_of_v t
+;;
+
+let sexp_of_m__t__stack
   (type k)
-  (module K : Sexp_of_m with type t = k[@alloc a])
+  (module K : Sexp_of_m__stack with type t = k)
   sexp_of_v
   t
   =
-  (sexp_of_t [@alloc a]) (K.sexp_of_t [@alloc a]) sexp_of_v t [@exclave_if_stack a]
+  sexp_of_t__stack K.sexp_of_t__stack sexp_of_v t
 ;;
 
 let m__t_of_sexp
diff --git a/src/set.ml b/src/set.ml
index d452ba4..30950ca 100644
--- a/src/set.ml
+++ b/src/set.ml
@@ -1865,12 +1865,16 @@ module type Equal_m = sig end
 module type Globalize_m = sig end
 module type Hash_fold_m = Hasher.S
 
-let%template[@alloc a @ m = (heap_global, stack_local)] sexp_of_m__t
+let sexp_of_m__t (type elt) (module Elt : Sexp_of_m with type t = elt) t =
+  sexp_of_t Elt.sexp_of_t t
+;;
+
+let sexp_of_m__t__stack
   (type elt)
-  (module Elt : Sexp_of_m with type t = elt[@alloc a])
+  (module Elt : Sexp_of_m__stack with type t = elt)
   t
   =
-  (sexp_of_t [@alloc a]) (Elt.sexp_of_t [@alloc a]) t [@exclave_if_stack a]
+  sexp_of_t__stack Elt.sexp_of_t__stack t
 ;;
 
 let m__t_of_sexp
-- 
2.51.2


