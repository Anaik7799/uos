From 9ae237764ad5d27997b3fce315447457bf7d47c7 Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 2 Aug 2026 22:58:13 +0200
Subject: [PATCH 1/4] compat: disambiguate Base iarray internals on OCaml 5.5

---
 src/linked_queue.ml | 4 ++--
 src/queue.ml        | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/linked_queue.ml b/src/linked_queue.ml
index 72de237..8ef941e 100644
--- a/src/linked_queue.ml
+++ b/src/linked_queue.ml
@@ -133,7 +133,7 @@ let of_array array =
   t
 ;;
 
-let of_iarray iarray = of_array (Iarray.unsafe_to_array__promise_no_mutation iarray)
+let of_iarray iarray = of_array (Iarray0.unsafe_to_array__promise_no_mutation iarray)
 
 let init len ~f =
   let t = create () in
@@ -155,7 +155,7 @@ let to_array t =
     arr
 ;;
 
-let to_iarray t = Iarray.unsafe_of_array__promise_no_mutation (to_array t)
+let to_iarray t = Iarray0.unsafe_of_array__promise_no_mutation (to_array t)
 let t_of_sexp a_of_sexp sexp = of_list (list_of_sexp a_of_sexp sexp)
 let sexp_of_t sexp_of_a t = sexp_of_list sexp_of_a (to_list t)
 
diff --git a/src/queue.ml b/src/queue.ml
index 643047b..99d268c 100644
--- a/src/queue.ml
+++ b/src/queue.ml
@@ -486,8 +486,8 @@ let init len ~f =
 
 let of_array a = init (Array.length a) ~f:(Array.unsafe_get a)
 let to_array t = Array.init t.length ~f:(fun i -> unsafe_get t i)
-let of_iarray iarray = of_array (Iarray.unsafe_to_array__promise_no_mutation iarray)
-let to_iarray t = Iarray.unsafe_of_array__promise_no_mutation (to_array t)
+let of_iarray iarray = of_array (Iarray0.unsafe_to_array__promise_no_mutation iarray)
+let to_iarray t = Iarray0.unsafe_of_array__promise_no_mutation (to_array t)
 
 let map ta ~f =
   let num_mutations = ta.num_mutations in
-- 
2.51.2


