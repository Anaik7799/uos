+    (* OCaml 5.5's stdlib puts explicit universal quantification in
+       camlinternalFormatBasics.mli, which every interface reaches through
+       Printf/Format. Rejecting it made gospel unable to read the 5.5 stdlib at
+       all. Bind the quantified names as ordinary type variables and recurse
+       into the body: gospel's type language has no rank-n types, so this
+       erases the quantifier rather than modelling it, which is sound for the
+       signature scanning gospel does here and is why the bound names must be
+       added to [tvl] instead of being ignored. *)
+    | Ptyp_poly (vars, ct) ->
+        let tvl =
+          List.fold_left
+            (fun acc v -> Mstr.add v.txt (tv_of_string ~loc v.txt) acc)
+            tvl vars
+        in
+        parse_core alias tvl ct
+    (* ast500 has no Ptyp_open in core_type_desc; the arm is unreachable. *)
+    (* Same 5.5-stdlib reason as Ptyp_poly above. Gospel's type language has no
+       polymorphic variants, so the type is admitted as OPAQUE — a fresh type
+       variable, exactly as Ptyp_any is treated. This is an APPROXIMATION, not
+       support: a specification written about a polymorphic-variant value is
+       checked against an unknown type and therefore constrains nothing. It is
+       admissible only because the constructs reached here are stdlib internals
+       no specification refers to. This bound must be disclosed wherever a
+       gospel verdict is cited as evidence. *)
+    | Ptyp_variant _ -> { ty_node = Tyvar (create_tv (Ident.create ~loc "_")) }
