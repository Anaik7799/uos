+  (* SAME TWO APPROXIMATIONS AS parse_core BELOW, and they must be applied in
+     BOTH places: this is the second of gospel's two core-type mapping
+     functions, and patching only the other one left `assert false` reachable —
+     an internal error rather than a diagnostic — for any interface that
+     mentions an explicitly quantified type or a polymorphic variant here.
+
+     Ptyp_poly: the quantifier is ERASED and the body mapped; gospel's type
+     language has no rank-n types. The bound names still map through Ptyp_var
+     above, so nothing is left dangling.
+
+     Ptyp_variant: admitted as OPAQUE — a fresh type variable, exactly as
+     Ptyp_any is treated one arm up. A specification written about such a value
+     is checked against an unknown type and therefore CONSTRAINS NOTHING. This
+     is an approximation, not support, and the bound must travel with any
+     gospel verdict cited as evidence. *)
+  | Ptyp_poly (_, ct) -> ty_of_core ns ct
+  | Ptyp_variant _ -> { ty_node = Tyvar (create_tv (Ident.create ~loc "_")) }
   | _ -> assert false
 
