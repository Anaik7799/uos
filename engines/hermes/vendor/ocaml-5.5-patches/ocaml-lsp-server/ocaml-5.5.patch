From 5012abcade492a93465bc3d7ec831edf46f23624 Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 2 Aug 2026 23:55:50 +0200
Subject: [PATCH] compat: use standard lexicographic list compare

---
 ocaml-lsp-server.opam                                    | 5 -----
 ocaml-lsp-server/src/custom_requests/req_locate_types.ml | 2 +-
 ocaml-lsp-server/src/import.ml                           | 2 +-
 3 files changed, 2 insertions(+), 7 deletions(-)

diff --git a/ocaml-lsp-server.opam b/ocaml-lsp-server.opam
index e0d95c23..c6eec108 100644
--- a/ocaml-lsp-server.opam
+++ b/ocaml-lsp-server.opam
@@ -64,9 +64,4 @@ build: [
   ]
 ]
 
-pin-depends: [
-  [ "merlin-lib.5.7-504" "git+https://github.com/ocaml/merlin.git#main" ]
-  [ "ocaml-index.5.7-504" "git+https://github.com/ocaml/merlin.git#main" ]
-]
-
 x-maintenance-intent: [ "(latest)" ]
diff --git a/ocaml-lsp-server/src/custom_requests/req_locate_types.ml b/ocaml-lsp-server/src/custom_requests/req_locate_types.ml
index 50bb35a7..73a4a7b7 100644
--- a/ocaml-lsp-server/src/custom_requests/req_locate_types.ml
+++ b/ocaml-lsp-server/src/custom_requests/req_locate_types.ml
@@ -56,7 +56,7 @@ module TySet = Set.Make (struct
     type t = string * DocumentUri.t option * Position.t
 
     let compare (ty_a, doc_a, pos_a) (ty_b, doc_b, pos_b) =
-      let c = Option.compare DocumentUri.compare doc_a doc_b in
+      let c = Stdlib.Option.compare DocumentUri.compare doc_a doc_b in
       if Int.equal 0 c
       then (
         let c = Position.compare pos_a pos_b in
diff --git a/ocaml-lsp-server/src/import.ml b/ocaml-lsp-server/src/import.ml
index 1119bd46..5d03dd28 100644
--- a/ocaml-lsp-server/src/import.ml
+++ b/ocaml-lsp-server/src/import.ml
@@ -63,7 +63,7 @@ module List = struct
   include Base.List
 
   let compare xs ys ~compare =
-    Base.List.compare (fun x y -> Ordering.to_int (compare x y)) xs ys
+    Stdlib.List.compare (fun x y -> Ordering.to_int (compare x y)) xs ys
   ;;
 
   let sort xs ~compare = sort xs ~compare:(fun x y -> Ordering.to_int (compare x y))
-- 
2.51.2

