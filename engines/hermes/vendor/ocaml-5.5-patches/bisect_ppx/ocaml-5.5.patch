From eee8c256a3b80eebe963173367caac062482200f Mon Sep 17 00:00:00 2001
From: Your Name <your.email@example.com>
Date: Sun, 2 Aug 2026 21:47:41 +0200
Subject: [PATCH 1/2] fix: support OCaml 5.5 function AST

---
 bisect_ppx.opam       |  4 +-
 src/ppx/instrument.ml | 90 +++++++++++++++++++++++++++----------------
 2 files changed, 59 insertions(+), 35 deletions(-)

diff --git a/bisect_ppx.opam b/bisect_ppx.opam
index d7e5700..00f016c 100644
--- a/bisect_ppx.opam
+++ b/bisect_ppx.opam
@@ -21,8 +21,8 @@ depends: [
   "base-unix"
   "cmdliner" {>= "1.3.0"}
   "dune" {>= "2.7.0"}
-  "ocaml" {>= "4.03.0"}
-  "ppxlib" {>= "0.28.0"}
+  "ocaml" {>= "5.5.0"}
+  "ppxlib" {>= "0.38.0"}
 
   "dune" {with-test & >= "3.0.0"}
   "ocamlformat" {with-test & = "0.16.0"}
diff --git a/src/ppx/instrument.ml b/src/ppx/instrument.ml
index 7a30033..1c21b8b 100644
--- a/src/ppx/instrument.ml
+++ b/src/ppx/instrument.ml
@@ -1314,38 +1314,62 @@ class instrumenter =
             instrument_expr ~use_loc_of:e ~post:true (Exp.assert_ e_new)
 
           (* Expressions that have subexpressions that might not get visited. *)
-          | Pexp_function cases ->
-            traverse_cases ~is_in_tail_position:true cases
-            >>| fun cases_new ->
-            let cases, _, _, need_binding = instrument_cases cases_new in
-            if need_binding then
-              Exp.fun_ ~loc ~attrs
-                Ppxlib.Nolabel None ([%pat? ___bisect_matched_value___])
-                (Exp.match_ ~loc
-                  ([%expr ___bisect_matched_value___]) cases)
-            else
-              Exp.function_ ~loc ~attrs cases
-
-          | Pexp_fun (label, default_value, p, e) ->
-            begin match default_value with
-            | None ->
-              return None
-            | Some e ->
-              traverse ~is_in_tail_position:false e
-              >>| fun e ->
-              Some (instrument_expr e)
-            end
-            >>= fun default_value ->
-            traverse ~is_in_tail_position:true e
-            >>| fun e ->
-            let e =
-              match e.pexp_desc with
-              | Pexp_function _ | Pexp_fun _ -> e
-              | Pexp_constraint (e', t) ->
-                {e with pexp_desc = Pexp_constraint (instrument_expr e', t)}
-              | _ -> instrument_expr e
+          | Pexp_function (params, type_constraint, body) ->
+            let traverse_param param =
+              match param.Parsetree.pparam_desc with
+              | Pparam_newtype _ ->
+                return param
+              | Pparam_val (_, None, _) ->
+                return param
+              | Pparam_val (label, Some default_value, pattern) ->
+                traverse ~is_in_tail_position:false default_value
+                >>| fun default_value ->
+                {param with pparam_desc =
+                  Pparam_val
+                    (label, Some (instrument_expr default_value), pattern)}
             in
-            Exp.fun_ ~loc ~attrs label default_value p e
+            List.map traverse_param params |> collect_errors
+            >>= fun params ->
+            begin match body with
+            | Pfunction_cases (cases, body_loc, body_attrs) ->
+              traverse_cases ~is_in_tail_position:true cases
+              >>| fun cases_new ->
+              let cases, _, _, need_binding = instrument_cases cases_new in
+              if need_binding then
+                let matched_value = [%pat? ___bisect_matched_value___] in
+                let parameter = Parsetree.{
+                  pparam_loc = matched_value.ppat_loc;
+                  pparam_desc =
+                    Pparam_val (Ppxlib.Nolabel, None, matched_value);
+                } in
+                let body =
+                  Exp.match_ ~loc ~attrs
+                    ([%expr ___bisect_matched_value___]) cases
+                in
+                {e with pexp_desc =
+                  Pexp_function
+                    (params @ [parameter], type_constraint,
+                      Pfunction_body body)}
+              else
+                {e with pexp_desc =
+                  Pexp_function
+                    (params, type_constraint,
+                      Pfunction_cases (cases, body_loc, body_attrs))}
+            | Pfunction_body body ->
+              traverse ~is_in_tail_position:true body
+              >>| fun body ->
+              let body =
+                match body.pexp_desc with
+                | Pexp_function _ -> body
+                | Pexp_constraint (body', typ) ->
+                  {body with pexp_desc =
+                    Pexp_constraint (instrument_expr body', typ)}
+                | _ -> instrument_expr body
+              in
+              {e with pexp_desc =
+                Pexp_function
+                  (params, type_constraint, Pfunction_body body)}
+            end
 
           | Pexp_match (e, cases) ->
             traverse_cases ~is_in_tail_position cases
@@ -1418,7 +1442,7 @@ class instrumenter =
           | Pexp_lazy e ->
             let rec is_trivial_syntactic_value e =
               match e.Parsetree.pexp_desc with
-              | Pexp_function _ | Pexp_fun _ | Pexp_poly _ | Pexp_ident _
+              | Pexp_function _ | Pexp_poly _ | Pexp_ident _
               | Pexp_constant _ | Pexp_construct (_, None) ->
                 true
               | Pexp_constraint (e, _) | Pexp_coerce (e, _, _) ->
@@ -1446,7 +1470,7 @@ class instrumenter =
             >>| fun e ->
             let e =
               match e.pexp_desc with
-              | Pexp_function _ | Pexp_fun _ -> e
+              | Pexp_function _ -> e
               | _ -> instrument_expr e
             in
             Exp.poly ~loc ~attrs e t
-- 
2.51.2


