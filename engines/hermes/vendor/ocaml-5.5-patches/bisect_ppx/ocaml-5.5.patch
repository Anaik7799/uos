@@ -1314,62 +1314,38 @@ class instrumenter =
             instrument_expr ~use_loc_of:e ~post:true (Exp.assert_ e_new)
 
           (* Expressions that have subexpressions that might not get visited. *)
-          | Pexp_function (params, type_constraint, body) ->
-            let traverse_param param =
-              match param.Parsetree.pparam_desc with
-              | Pparam_newtype _ ->
-                return param
-              | Pparam_val (_, None, _) ->
-                return param
-              | Pparam_val (label, Some default_value, pattern) ->
-                traverse ~is_in_tail_position:false default_value
-                >>| fun default_value ->
-                {param with pparam_desc =
-                  Pparam_val
-                    (label, Some (instrument_expr default_value), pattern)}
-            in
-            List.map traverse_param params |> collect_errors
-            >>= fun params ->
-            begin match body with
-            | Pfunction_cases (cases, body_loc, body_attrs) ->
-              traverse_cases ~is_in_tail_position:true cases
-              >>| fun cases_new ->
-              let cases, _, _, need_binding = instrument_cases cases_new in
-              if need_binding then
-                let matched_value = [%pat? ___bisect_matched_value___] in
-                let parameter = Parsetree.{
-                  pparam_loc = matched_value.ppat_loc;
-                  pparam_desc =
-                    Pparam_val (Ppxlib.Nolabel, None, matched_value);
-                } in
-                let body =
-                  Exp.match_ ~loc ~attrs
-                    ([%expr ___bisect_matched_value___]) cases
-                in
-                {e with pexp_desc =
-                  Pexp_function
-                    (params @ [parameter], type_constraint,
-                      Pfunction_body body)}
-              else
-                {e with pexp_desc =
-                  Pexp_function
-                    (params, type_constraint,
-                      Pfunction_cases (cases, body_loc, body_attrs))}
-            | Pfunction_body body ->
-              traverse ~is_in_tail_position:true body
-              >>| fun body ->
-              let body =
-                match body.pexp_desc with
-                | Pexp_function _ -> body
-                | Pexp_constraint (body', typ) ->
-                  {body with pexp_desc =
-                    Pexp_constraint (instrument_expr body', typ)}
-                | _ -> instrument_expr body
-              in
-              {e with pexp_desc =
-                Pexp_function
-                  (params, type_constraint, Pfunction_body body)}
+          | Pexp_function cases ->
+            traverse_cases ~is_in_tail_position:true cases
+            >>| fun cases_new ->
+            let cases, _, _, need_binding = instrument_cases cases_new in
+            if need_binding then
+              Exp.fun_ ~loc ~attrs
+                Ppxlib.Nolabel None ([%pat? ___bisect_matched_value___])
+                (Exp.match_ ~loc
+                  ([%expr ___bisect_matched_value___]) cases)
+            else
+              Exp.function_ ~loc ~attrs cases
+
+          | Pexp_fun (label, default_value, p, e) ->
+            begin match default_value with
+            | None ->
+              return None
+            | Some e ->
+              traverse ~is_in_tail_position:false e
