(rule
 (alias runtest)
 (action (run ./test_vision_fuzz.exe)))

(executable
 (name vision_render_all)
 (modules vision_render_all)
 (libraries hermes_vision))

; EXPECT TEST. The ontologies are data, and data changes silently: a
; hazard reworded, an origin flipped, a channel renamed. None breaks a
; structural test; all change what the system claims. This makes each
; one a reviewable diff. Regenerate with:
;   dune promote modules/hermes_vision
(rule
 (alias runtest)
 (action
  (progn
   (with-stdout-to vision.actual (run %{exe:vision_render_all.exe}))
   (diff vision.expected vision.actual))))

