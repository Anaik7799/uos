; The toolchain gate. The pure derivation is a LIBRARY so the test links
; the shipped code rather than a copy of it — the first cut duplicated it
; by value and the two copies had already diverged. `unix` is the only
; production verification also links the pure Ed25519 verification leaf so
; the pinned provider self-test is evidence from the shipped implementation.

(library
 (name toolchain_core)
 (wrapped false)
 (modules toolchain_core))

(executable
 (name toolchain_check)
 (modules toolchain_check)
 (libraries unix toolchain_core hermes_dependability_approval_crypto))

(executable
 (name test_toolchain_check)
 (modules test_toolchain_check)
 (libraries toolchain_core hermes_harness_suite_telemetry))

(executable
 (name test_tool_hygiene)
 (modules test_tool_hygiene)
 (libraries hermes_harness_suite_telemetry))

; The preflight's denotational core is a LIBRARY for the same reason
; toolchain_core is: the law suite must link the shipped semantics, not a copy.
; It is deliberately pure -- no unix, no process, no clock -- so every law below
; is about MEANING, and the effectful shell (tools/preflight) only supplies
; observations.

(library
 (name preflight_algebra)
 (wrapped false)
 (modules preflight_algebra))

(executable
 (name test_preflight_algebra)
 (modules test_preflight_algebra)
 (libraries preflight_algebra hermes_harness_suite_telemetry))

; The atlas conformance core, same split and same reason as preflight_algebra:
; the law suite must link the shipped semantics, not a copy. Pure -- no unix,
; no IO -- so every law is about MEANING; atlas_check.ml supplies observations.

(library
 (name atlas_algebra)
 (wrapped false)
 (modules atlas_algebra))

(executable
 (name test_atlas_algebra)
 (modules test_atlas_algebra)
 (libraries atlas_algebra hermes_harness_suite_telemetry))

; The effectful shell. Kept separate from the library so the law suite links
; no IO and no JSON parser -- a law that could fail on a parse bug is not a law
; about meaning.

(executable
 (name atlas_check)
 (modules atlas_check)
 (libraries yojson atlas_algebra))

; Task-authority health. Pure, like the other cores here: it reads no database
; and samples no clock, so every law is about MEANING. tools/lease-health
; supplies the rows and the instant.

(library
 (name lease_health)
 (wrapped false)
 (modules lease_health))

(executable
 (name test_lease_health)
 (modules test_lease_health)
 (libraries lease_health hermes_harness_suite_telemetry))
