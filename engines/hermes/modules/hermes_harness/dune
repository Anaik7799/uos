 (modules test_r30_adoption)
 (libraries hermes_harness_suite_telemetry))

(rule
 (alias runtest)
 (deps %{project_root}/dune-project (source_tree %{project_root}/modules) %{project_root}/modules/hermes_harness/baseline/r30-adoption.txt)
 (action (chdir %{project_root} (run %{exe:test_r30_adoption.exe}))))

