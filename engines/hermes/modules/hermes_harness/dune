; Zenoh publisher: links the PREBUILT vendored zenoh-c static library
; (vendor/zenoh-c, mirrored into the build tree by dune) through one C stub --
; the same foreign-archive discipline as the Rust rule engine. No new external
; tool: FFI, not a subprocess, so the permitted-oracle list is untouched.
(rule
 (targets libzenohc.a)
 (deps ../../vendor/zenoh-c/lib/libzenohc.a)
 (action (copy ../../vendor/zenoh-c/lib/libzenohc.a libzenohc.a)))

(library
 (name hermes_harness_hermes_zenoh)
 (wrapped false)
 (modules hermes_zenoh)
 (foreign_stubs (language c) (names hz_stubs)
  (flags (:standard -I%{project_root}/vendor/zenoh-c/include))
  ; vendor/ is data_only: files are mirrored into _build lazily, only when
  ; something depends on them -- the headers must be declared or the include
  ; path above points at an empty directory.
  (extra_deps (glob_files %{project_root}/vendor/zenoh-c/include/*.h)))
 (foreign_archives zenohc)
 (c_library_flags (-lpthread -ldl -lm -lrt))
 (libraries unix threads))

