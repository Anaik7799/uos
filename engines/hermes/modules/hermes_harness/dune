(library
 (name hermes_harness_hermes_rete)
 (wrapped false)
 (modules hermes_rete))

; The embedded Rust rule engine (rust/drift_engine): built hermetically by cargo
; from committed, vendored sources (--offline, no network), then linked as a
; foreign archive. The OCaml side talks to it through one C stub.
(rule
 (targets libhermes_drift_engine.a)
 ; rebuild when the crate's own sources change; the vendored deps are pinned by
 ; Cargo.lock, and the build is --offline against the committed vendor dir.
 (deps ../../rust/drift_engine/Cargo.toml ../../rust/drift_engine/Cargo.lock
       ../../rust/drift_engine/src/lib.rs)
 (action
  (no-infer
   (progn
    ; cargo builds the SOURCE crate in place (dune's source_tree copy skips
    ; dot-dirs, which breaks vendored checksums). Paths are relative to this
    ; rule's cwd: _build/default/hermes_harness -> ../../.. is the source root.
    (run cargo build --release --offline
         --manifest-path ../../../../rust/drift_engine/Cargo.toml
         --config "source.crates-io.replace-with='vendored-sources'"
         --config "source.vendored-sources.directory='../../../../rust/drift_engine/vendor'")
    ; run-cp, not dune copy: run's args are cwd-relative (like the cargo call
    ; above), while dune's copy resolves against the source dir.
    (run cp ../../../../rust/drift_engine/target/release/libhermes_drift_engine.a
         libhermes_drift_engine.a)))))

(library
 (name hermes_harness_rust_rules)
 (wrapped false)
 (modules rust_rules)
 (foreign_stubs (language c) (names hde_stubs))
 (foreign_archives hermes_drift_engine)
 (c_library_flags (-lpthread -ldl -lm))
 (libraries yojson))

