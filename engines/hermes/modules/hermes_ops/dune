; Operations offload: repository verification expressed as a declarative
; intent and executed by the swarm engine (Sop_execution), so an agent
; spends one command and one line of context on a pass that used to cost
; ~40 commands and their full scrollback.
;
; It lives OUTSIDE modules/hermes_wiki on purpose: the wiki engine's dune
; carries a guard law forbidding any hermes_harness_* dependency, and this
; module needs one. Keeping it here satisfies the law instead of widening it.

(library
 (name hermes_ops_capability_core)
 (wrapped false)
 (modules ops_capability)
 (libraries digestif))

(library
 (name hermes_ops_capability)
 (wrapped false)
 (modules ops_capability_gate module_intent)
 (libraries (re_export hermes_ops_capability_core)
  hermes_stanza hermes_fpp_window_authority))

(library
 (name hermes_ops_config_authority)
 (wrapped false)
 (modules ops_config ops_config_ontology ops_config_atlas ops_config_algebra)
 (libraries digestif))

(library
 (name hermes_debugging)
 (wrapped false)
 (modules debug_ontology debug_dependability debug_intent debug_algebra debug_protocol)
 (libraries hermes_ops_capability_core digestif))

(library
 (name hermes_external_access)
 (wrapped false)
 (modules external_access external_access_runtime external_access_observability external_access_otp_register external_access_census)
 (libraries hermes_ops_capability_core hermes_wiki_fpp digestif unix))

; ---------------------------------------------------------------- leaves
;
; These three modules used to live in the aggregate below, which depends
; on hermes_ops_dashboard. That made them unreachable from the dashboard's
; own Run_formal_relation, because importing them would have closed
;
;   hermes_ops_dashboard -> hermes_ops -> hermes_ops_dashboard
;
; and Task 5's formal relation must assert cross-model window disjointness
; over the exact five models, two of which are here. Copying their spans
; into the formula was rejected: it would create the stale second
; authority the formula exists to detect.
;
; No .ml moved or was renamed. Only module OWNERSHIP changed, and the
; aggregate re-exports all three, so every existing consumer keeps the
; same unwrapped module names.
;
; Governance had to come out too. Ops_topology.governance_channels derives
; monitor channels from Ops_governance.obligations, so leaving governance
; in the aggregate would have moved the cycle rather than broken it. It is
; a valid leaf: its only non-stdlib qualifier is Ops_capability — the
; Fpp_model., Ops_command. and Ops_command_runtime. occurrences in that
; file are all inside string literals, verified rather than assumed.
(library
 (name hermes_ops_governance)
 (wrapped false)
 (modules ops_governance)
 (libraries hermes_ops_capability_core))

(library
 (name hermes_ops_topology)
 (wrapped false)
 (modules ops_topology)
 (libraries hermes_ops_governance hermes_ops_capability_core
   hermes_fpp_window_authority hermes_wiki_fpp))

(library
 (name hermes_ops_completion_topology)
 (wrapped false)
 (modules ops_completion_topology)
 (libraries hermes_fpp_window_authority hermes_wiki_fpp))

; ------------------------------------------------------------- aggregate
(library
 (name hermes_ops)
 (wrapped false)
 (modules ops_verify ops_mutate ops_formal ops_agents ops_config_gate ops_config_docs module_intent_docs debug_docs ops_command ops_governance_model ops_governance_formal ops_mbse ops_observability ops_completion_history ops_command_runtime ops_command_service ops_mcp ops_zenoh ops_verification_target)
 (libraries (re_export hermes_ops_capability)
   (re_export hermes_ops_config_authority)
   (re_export hermes_debugging)
   (re_export hermes_ops_governance)
   (re_export hermes_ops_topology)
   (re_export hermes_ops_completion_topology)
   hermes_fpp_window_authority hermes_harness_sop_execution hermes_harness_harness_topology
   hermes_harness_hermes_zenoh hermes_wiki_fpp hermes_wiki_mbse hermes_harness_orientation_history
   hermes_dependability_sqlite_location hermes_dependability_sqlite digestif yojson unix
   hermes_ops_dashboard))

