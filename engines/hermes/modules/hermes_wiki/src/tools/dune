; The acceptance ratchet for the render baseline: classify every pin delta
; before a re-pin, and BLOCK on removals unless explicitly acknowledged.
(library
 (name wiki_baseline_triage)
 (wrapped false)
 (modules baseline_triage))

(executable
 (name gen_render_baseline)
 (modules gen_render_baseline)
 (libraries wiki_core hermes_wiki_core wiki_baseline_triage))

(executable
 (name test_baseline_triage)
 (modules test_baseline_triage)
 (libraries wiki_baseline_triage wiki_suite_telemetry))

(rule
 (alias runtest)
 (action (run %{exe:test_baseline_triage.exe})))

