  mirage_solo5_tender
  mirage_interceptor
  mirage_benchmark
  mirage_migration_catalog
  mirage_dns_resolver
  mirage_tls_ingress
  mirage_hypervisor_probe)
 (libraries digestif yojson mirage-crypto mirage-crypto-ec unix))

(executable
 (name test_mirage_core)
 (modules test_mirage_core)
 (libraries hermes_mirage))

(executable
 (name test_mirage_migration)
 (modules test_mirage_migration)
 (libraries hermes_mirage))

