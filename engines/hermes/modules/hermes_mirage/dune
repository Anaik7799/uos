 (name test_mirage_benchmark)
 (modules test_mirage_benchmark)
 (libraries hermes_mirage unix yojson))

(rule
 (alias runtest)
 (action (run ./test_mirage_benchmark.exe %{exe:hermes_mirage_runner.exe})))

