# ==============================================================================
# Unified Operational System (UOS) - Root Gitignore / VCS Ignore
# ==============================================================================

# Sibling Jujutsu Workspaces
/.uos-workspaces/

# Ephemeral runtime, scratch, and local var
/var/
*.tmp
*.log
*.pid

# SQLite live journals & locks (never commit live DB states)
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.lock
*.materialize.lock

# Security & Quarantined Secrets (Zero-Tolerance)
*.pem
*.key
*.token
*.id_rsa
*.id_ed25519
id_rsa*
id_ed25519*
.env
.env.*
!.env.example
credentials.json
service-account*.json
oauth_client_secret*.json

# Gleam / BEAM Build Artifacts
build/
_build/
*.beam

# OCaml / Dune Build Artifacts
_opam/
_esy/
*.cmi
*.cmo
*.cmx
*.cma
*.cmxa
*.cmxs
*.annot

# Zig Build Artifacts
zig-cache/
zig-out/

# Rust / Cargo Build Artifacts
target/

# Python / Modular MAX Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.mojom
*.mojo-cache/

# Node / Web Artifacts
node_modules/
dist/
.next/

# OS / Editor Metadata
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.zig-cache/
