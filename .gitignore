# ==============================================================================
# Unified Operational System (UOS) - Root Gitignore / VCS Ignore
# ==============================================================================

# Sibling Jujutsu Workspaces
/.uos-workspaces/

# Ephemeral runtime, scratch, and local var
/var/
*.tmp
*.log
*.pid

# SQLite live journals & locks (never commit live DB states)
sa_plan.sqlite3
**/state/*.sqlite3
# Runtime coordinator and holarchy stores: regenerable, never source.
**/var/coordination/**/*.sqlite3
**/var/holarchy/*.sqlite3
# Stray databases written into a package root by tests or ad-hoc probes
# (2026-09-07: review agents left apps/uos_swarm/{crash,race}.sqlite3).
apps/*/*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.lock
*.materialize.lock

# Security & Quarantined Secrets (Zero-Tolerance)
*.pem
*.key
*.token
*.id_rsa
*.id_ed25519
id_rsa*
id_ed25519*
.env
.env.*
!.env.example
credentials.json
service-account*.json
oauth_client_secret*.json

# Gleam / BEAM Build Artifacts
build/
_build/
*.beam
erl_crash.dump

# OCaml / Dune Build Artifacts
_opam/
_esy/
*.cmi
*.cmo
*.cmx
*.cma
*.cmxa
*.cmxs
*.annot
*.o

# Zig Build Artifacts
zig-cache/
zig-out/

# Rust / Cargo Build Artifacts
target/

# Python / Modular MAX Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.mojom
*.mojo-cache/

# Node / Web Artifacts
node_modules/
dist/
.next/

# OS / Editor Metadata
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.zig-cache/

# Large vendor binaries
*.so
*.a

# ferriskey_nif is a cdylib NIF: its lockfile is part of the reproducible build (governance/sources/20260907-1330-ferriskey-nif-source-ingestion.json)
!native/nifs/rust/ferriskey_nif/Cargo.lock
apps/uos_swarm/test/scratch_systemd/

# The MAX/Mojo toolchain lock pins every Modular and conda-forge artifact by URL
# and hash: it is the reproducible-build manifest for the inference tier, not a
# live lock (governance/sources/20260907-2300-modular-max-mojo-toolchain-installation.json).
# The environment itself (services/inference/max/.pixi/, ~1 GB) stays untracked,
# exactly like the host-provisioned priv/*.so artifacts.
!services/inference/max/pixi.lock

# flake.lock pins the Determinate Nix / FlakeHub nixpkgs revision that provides
# OTP 29, Zig, Z3 and Quint (SC-NIX-DEVENV-001). The blanket `*.lock` rule above
# targets LIVE locks; this is a reproducible-build manifest, exactly like
# Cargo.lock and pixi.lock. Ignoring it would leave the FlakeHub `nixpkgs-weekly/*`
# wildcard floating and the flake would pin nothing.
!flake.lock

# devenv.lock pins the devenv/nixpkgs inputs the `devenv shell` and `devenv test`
# entrypoints resolve. Same reasoning as flake.lock: reproducible-build manifest,
# not a live lock. Without it `devenv test` would assert OTP 29 against whatever
# the inputs happened to resolve to that day.
!devenv.lock

# devenv's generated state: /nix/store symlinks, bootstrap copies and GC roots.
# Regenerated by any `devenv` invocation, machine-specific, never evidence.
.devenv/
.devenv.flake.nix
_apalache-out/

# Formal toolchains are host-provisioned, in-project, and untracked (operator
# mandate: all toolchains live inside the UOS project). Each is pinned by URL and
# hash in a governance/sources/ installation manifest, exactly like the MAX/Mojo
# pixi environment and the priv/*.so NIF artifacts.
toolchains/

# Node deployment runtime archives (served dynamically via HTTP)
ops/nodes/*/*.tar.gz
*.tar.gz
