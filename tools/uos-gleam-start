#!/usr/bin/env bash
# =============================================================================
# tools/uos-gleam-start — Canonical UOS Gleam Wisp/Lustre Web Server Launcher
# =============================================================================
set -euo pipefail

UOS_ROOT="/home/an/NAS-setup/uos"
source "${UOS_ROOT}/tools/lib/uos-toolchain.sh"
uos_env

GLEAM_DIR="${UOS_ROOT}/apps/cepaf_gleam"
GLEAM_BIN="$(uos_tool_path gleam)"

cd "${GLEAM_DIR}"
exec "${GLEAM_BIN}" run -- --serve
