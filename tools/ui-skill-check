#!/usr/bin/env bash
# Report-only OCaml packaging checks; no network, agent or application actions.
set -euo pipefail
ui_repo="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if (( $# > 1 )) || { (( $# == 1 )) && [[ "$1" != "--selftest" ]]; }; then
  echo 'usage: bash tools/ui-skill-check [--selftest]' >&2
  exit 2
fi
for ui_tool in dune ocamlc ocamlfind timeout; do
  command -v "$ui_tool" >/dev/null || { echo "Missing prerequisite: $ui_tool" >&2; exit 2; }
done
ocamlfind query yojson cryptokit >/dev/null
ui_build="$(mktemp -d "${TMPDIR:-/tmp}/uos-ui-skills.XXXXXX")"
trap 'rm -rf -- "$ui_build"' EXIT
DUNE_CACHE=disabled timeout --kill-after=2s 45s dune build -j 1 \
  --root "$ui_repo/plugins/uos-interface-quality/validation" \
  --build-dir "$ui_build" ./check.exe
timeout --kill-after=2s 15s "$ui_build/default/check.exe" "$ui_repo" \
  "plugins/uos-interface-quality/references/20260907-2312-catalog.json" "$@"

