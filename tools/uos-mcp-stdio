#!/usr/bin/env bash
set -euo pipefail

UOS_ROOT="/home/an/NAS-setup/uos"
OCAML_BIN="/home/an/NAS-setup/uos/toolchains/opam-ocaml/bin/ocaml"
PINNED_RELEASE_FILE="${UOS_ROOT}/var/releases/ecology/current-mcp-release"

case "${1:-}" in
  --version)
    echo "uos-mcp-stdio 1.0.0 (OTP 29 unified 101-route Gleam MCP gateway)"
    exit 0
    ;;
  --help)
    cat <<'EOF'
Usage: tools/uos-mcp-stdio

Runs the unified Gleam MCP stdio gateway on Erlang/OTP 29.

Environment variables:
  UOS_MCP_ROUTE
  UOS_MCP_WORKSPACE_ROOT
  UOS_MCP_ACTOR_ID
  UOS_MCP_CLIENT_NAME
  UOS_MCP_SESSION_ID
  UOS_MCP_PROTOCOL_VERSION
  UOS_MCP_WIRE_MODE
  UOS_COCKPIT_RELEASE
  UOS_MCP_EXPECTED_PAYLOAD_SHA256
  UOS_MCP_ALLOW_DEV_BUILD
  UOS_MCP_FORCE_FULL_VERIFY
EOF
    exit 0
    ;;
esac

PINNED_ERL="/nix/store/96cqahwqjxzx4pywz1bj53apncjmhhdg-erlang-29.0.5/lib/erlang/bin/erl"
FALLBACK_ERL="/home/an/NAS-setup/uos/toolchains/nix-profile/bin/erl"
if [ -x "${PINNED_ERL}" ]; then
  ERL_BIN="${PINNED_ERL}"
else
  ERL_BIN="${FALLBACK_ERL}"
fi

if [ ! -x "${ERL_BIN}" ]; then
  echo "uos-mcp-stdio: Erlang runtime not found: ${ERL_BIN}" >&2
  exit 1
fi

export UOS_MCP_WORKSPACE_ROOT="${UOS_MCP_WORKSPACE_ROOT:-${UOS_ROOT}}"
export ERL_CRASH_DUMP=/dev/null
export ERL_CRASH_DUMP_SECONDS=0

if [ ! -d "${UOS_MCP_WORKSPACE_ROOT}" ]; then
  echo "uos-mcp-stdio: workspace root is not a directory: ${UOS_MCP_WORKSPACE_ROOT}" >&2
  exit 1
fi

CAPSULE=""
if [ -n "${UOS_COCKPIT_RELEASE:-}" ]; then
  CAPSULE="${UOS_COCKPIT_RELEASE}"
elif [ -f "${PINNED_RELEASE_FILE}" ]; then
  CAPSULE="$(head -n 1 "${PINNED_RELEASE_FILE}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
fi

if [ -n "${CAPSULE}" ]; then
  RUNTIME_BEAM="${CAPSULE}/apps/cepaf_gleam/ebin/cepaf_gleam@mcp@runtime_gateway.beam"
  if [ ! -f "${RUNTIME_BEAM}" ]; then
    echo "uos-mcp-stdio: runtime gateway beam missing in capsule: ${RUNTIME_BEAM}" >&2
    exit 1
  fi

  CAPSULE="$(realpath -e -- "${CAPSULE}")"
  for SEALED_PATH in "${CAPSULE}" "${CAPSULE}/release-manifest.json" "${CAPSULE}/source-manifest.json" "${CAPSULE}/runtime-dependencies.json"; do
    if [ ! -e "${SEALED_PATH}" ] || [ -w "${SEALED_PATH}" ] || [ -L "${SEALED_PATH}" ]; then
      echo "uos-mcp-stdio: capsule seal missing or writable" >&2
      exit 1
    fi
  done
  ACTUAL_PAYLOAD_SHA="$(sed -n 's/^[[:space:]]*"payload_sha256":[[:space:]]*"\([0-9a-f]\{64\}\)"[[:space:]]*,\{0,1\}[[:space:]]*$/\1/p' "${CAPSULE}/release-manifest.json")"
  if [[ ! "${ACTUAL_PAYLOAD_SHA}" =~ ^[0-9a-f]{64}$ ]] || { [ -n "${UOS_MCP_EXPECTED_PAYLOAD_SHA256:-}" ] && [ "${ACTUAL_PAYLOAD_SHA}" != "${UOS_MCP_EXPECTED_PAYLOAD_SHA256}" ]; }; then
    echo "uos-mcp-stdio: payload digest mismatch" >&2
    exit 1
  fi

  # A seal binds the whole capsule's inode/ctime inventory as well as the three
  # manifest hashes. Editing a BEAM then restoring mtime cannot reuse the seal.
  if [ -n "$(find "${CAPSULE}" -perm /222 -print -quit)" ]; then
    echo "uos-mcp-stdio: writable capsule payload refused" >&2
    exit 1
  fi
  BOOT_ID="$(cat /proc/sys/kernel/random/boot_id)"
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    CACHE_ROOT="${XDG_RUNTIME_DIR}/uos-mcp-verified"
  elif [ -d "/run/user/$(id -u)" ]; then
    CACHE_ROOT="/run/user/$(id -u)/uos-mcp-verified"
  else
    CACHE_ROOT="${HOME}/.cache/uos-mcp-verified-$(id -u)"
  fi
  if [ -L "${CACHE_ROOT}" ]; then
    echo "uos-mcp-stdio: unsafe verification cache" >&2; exit 1
  fi
  (umask 077; mkdir -p -- "${CACHE_ROOT}")
  if [ "$(stat -c '%u:%a' -- "${CACHE_ROOT}")" != "$(id -u):700" ]; then
    echo "uos-mcp-stdio: verification cache must be user-owned mode 0700" >&2; exit 1
  fi
  SEAL_KEY="$(printf '%s' "${CAPSULE}" | sha256sum | cut -d ' ' -f 1)"
  SEAL_FILE="${CACHE_ROOT}/${SEAL_KEY}"
  SEAL="$(
    {
      printf '%s\n' "${BOOT_ID}" "${CAPSULE}" "${ACTUAL_PAYLOAD_SHA}"
      stat -c '%d:%i:%s:%y:%z:%a' -- "${CAPSULE}"
      sha256sum -- "${CAPSULE}/release-manifest.json" "${CAPSULE}/source-manifest.json" "${CAPSULE}/runtime-dependencies.json"
      find "${CAPSULE}" -printf '%P %m %i %s %T@ %C@\n' | LC_ALL=C sort | sha256sum
    } | sha256sum | cut -d ' ' -f 1
  )"
  CACHE_HIT=0
  if [ -f "${SEAL_FILE}" ] && [ ! -L "${SEAL_FILE}" ] && [ "$(stat -c '%u:%a' -- "${SEAL_FILE}")" = "$(id -u):600" ] && [ "$(cat "${SEAL_FILE}")" = "${SEAL}" ]; then
    CACHE_HIT=1
  fi
  if [ "${CACHE_HIT}" != 1 ] || [ "${UOS_MCP_FORCE_FULL_VERIFY:-0}" = 1 ]; then
    VERIFY_OUT=""
    if ! VERIFY_OUT="$("${OCAML_BIN}" "${UOS_ROOT}/tools/ecology_release.ml" verify "${CAPSULE}")" || ! printf '%s' "${VERIFY_OUT}" | jq -e '.status == "PASS"' >/dev/null; then
      echo "uos-mcp-stdio: full capsule verification failed" >&2
      exit 1
    fi
    VERIFIED_PAYLOAD_SHA="$(printf '%s\n' "${VERIFY_OUT}" | jq -er '.payload_sha256')"
    if [ "${VERIFIED_PAYLOAD_SHA}" != "${ACTUAL_PAYLOAD_SHA}" ]; then
      echo "uos-mcp-stdio: verified payload mismatch" >&2; exit 1
    fi
    SEAL_TMP="$(mktemp "${CACHE_ROOT}/.seal.XXXXXXXX")"
    chmod 600 "${SEAL_TMP}"
    printf '%s\n' "${SEAL}" > "${SEAL_TMP}"
    mv -f -- "${SEAL_TMP}" "${SEAL_FILE}"
  fi

  UOS_MCP_EBIN_GLOB="${CAPSULE}/apps/*/ebin"
else
  if [ "${UOS_MCP_ALLOW_DEV_BUILD:-0}" != "1" ]; then
    echo "uos-mcp-stdio: refused unverified mutable build tree (set UOS_COCKPIT_RELEASE or var/releases/ecology/current-mcp-release; set UOS_MCP_ALLOW_DEV_BUILD=1 only for local development)" >&2
    exit 1
  fi
  UOS_MCP_EBIN_GLOB="${UOS_ROOT}/apps/cepaf_gleam/build/dev/erlang/*/ebin"
fi

export UOS_MCP_EBIN_GLOB

# The guarded-JSON module marks the bounded fd-reader ABI. Retained capsules
# without it use io:get_line and require OTP's input server. The capsule seal
# and payload checks above apply before either input mode is selected.
STDIN_MODE_ARGS=()
if [ -n "${CAPSULE}" ]; then
  NATIVE_STDIO_MARKER="${CAPSULE}/apps/cepaf_gleam/ebin/cepaf_gleam@mcp@json_guard.beam"
else
  NATIVE_STDIO_MARKER="${UOS_ROOT}/apps/cepaf_gleam/build/dev/erlang/cepaf_gleam/ebin/cepaf_gleam@mcp@json_guard.beam"
fi
if [ -f "${NATIVE_STDIO_MARKER}" ]; then
  STDIN_MODE_ARGS=(-noinput)
fi

exec "${ERL_BIN}" +S 2:2 +A 2 -noshell "${STDIN_MODE_ARGS[@]}" -eval 'io:setopts([{encoding, utf8}]), case file:set_cwd(os:getenv("UOS_MCP_WORKSPACE_ROOT")) of ok -> code:add_paths(filelib:wildcard(os:getenv("UOS_MCP_EBIN_GLOB"))), '\''cepaf_gleam@mcp@runtime_gateway'\'':stdio_main(), halt(0); {error, Reason} -> io:format(standard_error, "uos-mcp-stdio: set_cwd failed: ~p~n", [Reason]), halt(1) end.'
