    exit 1
  fi
done
echo "  [OK] All 9 UOS-ZLP-v3 #km-triad, contract, and skill documents verified present"

echo '{"status":"PASS","gate":"G-ZLP","admitted_ev_ceiling":93,"lean_theorems":20,"axiom_checks":'"$axiom_checks"',"zero_sorry_ax":true,"application_admitted":false,"system_admitted":false}'
echo "[PASS] UOS-ZLP-v3 Two-Key Formal + 9-Modality Runtime Gate (G-ZLP)"
