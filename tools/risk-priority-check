#!/usr/bin/env bash
# SC-RISK-PRIORITY-001: local OCaml report-only checks; isolated temporary build.
set -euo pipefail
risk_repo="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
for risk_tool in dune ocamlc ocamlfind timeout; do
  command -v "$risk_tool" >/dev/null || { echo "Missing toolchain dependency: $risk_tool" >&2; exit 2; }
done
ocamlfind query yojson >/dev/null || { echo "Missing OCaml package: yojson" >&2; exit 2; }
risk_build="$(mktemp -d "${TMPDIR:-/tmp}/uos-risk-priority.XXXXXX")"
trap 'rm -rf -- "$risk_build"' EXIT
cd "$risk_repo"
DUNE_CACHE=disabled timeout 90s dune build -j 1 \
  --root "$risk_repo/plugins/uos-risk-prioritization/validation" \
  --build-dir "$risk_build" ./validate.exe
if (( $# == 0 )); then set -- --package; fi
timeout 30s "$risk_build/default/validate.exe" "$@"

