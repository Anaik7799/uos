def verify_default_at_conservation() -> dict:
    mismatches = []
    for rel, expected in PROTECTED_DEFAULT_AT_DIGESTS.items():
        full = os.path.join(UOS_ROOT, rel)
        if not os.path.exists(full):
            mismatches.append({"file": rel, "error": "missing"})
        else:
            actual = sha256_file(full)
            if actual != expected:
                mismatches.append({"file": rel, "expected": expected, "actual": actual})
    return {"conserved": len(mismatches) == 0, "checked_files": len(PROTECTED_DEFAULT_AT_DIGESTS), "mismatches": mismatches}


def init_quota_db() -> sqlite3.Connection:
    ensure_dirs()
    conn = sqlite3.connect(QUOTA_DB, timeout=30.0)
    conn.execute("PRAGMA journal_mode=WAL;")
    conn.execute("PRAGMA synchronous=NORMAL;")
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS quota_events (
            seq_id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts_unix INTEGER NOT NULL,
            engine TEXT NOT NULL,
            task_id TEXT NOT NULL,
            agy_bps_delta INTEGER NOT NULL CHECK(agy_bps_delta >= 0),
            openrouter_nanodollars INTEGER NOT NULL CHECK(openrouter_nanodollars >= 0),
            note TEXT NOT NULL
        );
        CREATE TRIGGER IF NOT EXISTS quota_events_no_update
        BEFORE UPDATE ON quota_events
        BEGIN
            SELECT RAISE(ABORT, 'quota_events are append-only');
        END;
        CREATE TRIGGER IF NOT EXISTS quota_events_no_delete
        BEFORE DELETE ON quota_events
        BEGIN
            SELECT RAISE(ABORT, 'quota_events are append-only');
        END;
        """
    )
    conn.commit()
    return conn


def get_quota_snapshot(conn: sqlite3.Connection) -> dict:
    now = int(time.time())
    agy_5h = conn.execute(
        "SELECT COALESCE(SUM(agy_bps_delta), 0) FROM quota_events WHERE ts_unix >= ?",
        (now - 5 * 3600,),
    ).fetchone()[0]
    agy_7d = conn.execute(
        "SELECT COALESCE(SUM(agy_bps_delta), 0) FROM quota_events WHERE ts_unix >= ?",
        (now - 7 * 86400,),
    ).fetchone()[0]
    agy_30d = conn.execute(
        "SELECT COALESCE(SUM(agy_bps_delta), 0) FROM quota_events WHERE ts_unix >= ?",
        (now - 30 * 86400,),
    ).fetchone()[0]
    or_24h = conn.execute(
        "SELECT COALESCE(SUM(openrouter_nanodollars), 0) FROM quota_events WHERE ts_unix >= ?",
        (now - 86400,),
    ).fetchone()[0]
    last_seq = conn.execute("SELECT COALESCE(MAX(seq_id), 0) FROM quota_events").fetchone()[0]

    violations = []
    if agy_5h > HARD_CAP_BPS:
        violations.append("agy_5h_exceeds_60pct_cap")
    if agy_7d > HARD_CAP_BPS:
        violations.append("agy_7d_weekly_exceeds_60pct_cap")
    if agy_30d > HARD_CAP_BPS:
        violations.append("agy_30d_monthly_exceeds_60pct_cap")
    if or_24h > OR_HARD_CAP_ND:
        violations.append("openrouter_24h_exceeds_6usd_60pct_cap")

    or_bps = (or_24h * 10_000) // OR_DAILY_ROOT_ND
    max_bps = max(agy_5h, agy_7d, agy_30d, or_bps)
    min_margin_bps = 10_000 - max_bps

    shift_zero_or = or_24h >= OR_SOFT_SHIFT_ND
    batch_agy = agy_5h >= SOFT_5H_BPS or agy_7d >= SOFT_7D_BPS or agy_30d >= SOFT_30D_BPS
    if violations:
        status = "HOLD_MARGIN_40PCT"
        mode = "HOLD"
    elif shift_zero_or and batch_agy:
        status = "ADMITTED"
        mode = "zero_openrouter_and_batched_wakeups"
    elif shift_zero_or:
        status = "ADMITTED"
        mode = "zero_openrouter_shift"
    elif batch_agy:
        status = "ADMITTED"
        mode = "batch_conductor_wakeups"
    else:
        status = "ADMITTED"
        mode = "normal_dispatch"

    return {
        "status": status,
        "mode": mode,
        "agy_5h_bps": agy_5h,
        "agy_7d_bps": agy_7d,
        "agy_30d_bps": agy_30d,
        "openrouter_24h_nanodollars": or_24h,
        "openrouter_24h_usd": round(or_24h / 1_000_000_000.0, 4),
        "hard_cap_bps": HARD_CAP_BPS,
        "min_remaining_margin_bps": min_margin_bps,
        "min_remaining_margin_pct": round(min_margin_bps / 100.0, 2),
        "violations": violations,
        "last_seq_id": last_seq + 1,
    }


def current_candidate_sha256() -> str:
    res = subprocess.run(
        ["jj", "--ignore-working-copy", "-R", UOS_ROOT, "log", "-r", "main", "--no-graph", "-T", "commit_id"],
        capture_output=True,
        text=True,
        timeout=15,
    )
    cid = res.stdout.strip()
    if len(cid) == 64:
        return cid
    return sha256_bytes(cid.encode("utf-8"))


def validate_uos_v1_topic(topic: str) -> None:
    if topic.startswith("c3i/") or topic == "c3i" or "/c3i/" in topic:
        raise ValueError(f"ErrLegacySplitBrainTopic: refused legacy c3i topic '{topic}' (I28 fence)")
    parts = topic.split("/")
    if len(parts) < 4 or parts[0] != "uos" or parts[1] != "v1" or parts[2] not in {
        "quota", "saplan", "rca", "coord", "wave", "core_evo", "hive", "biomorphic", "fractal"
    }:
        raise ValueError(f"ErrInvalidUosV1Topic: '{topic}'")


def zenoh_publish_signed(
    topic: str,
    plan_id: str,
    task_id: str,
    worker_id: str,
    attempt: int,
    seq_id: int,
    payload_obj: dict,
) -> dict:
    validate_uos_v1_topic(topic)
    payload_json = json.dumps(payload_obj, separators=(",", ":"), sort_keys=True)
    if topic.startswith("uos/v1/wave/") and topic.endswith("/summary"):
        if len(payload_json.encode("utf-8")) > MAX_CONDUCTOR_DIGEST_BYTES:
            raise ValueError(f"ErrPayloadTooLarge: conductor digest > {MAX_CONDUCTOR_DIGEST_BYTES} bytes")

    envelope = {
        "schema": "uos.zenoh.core_evo.v1",
        "topic": topic,
        "candidate_sha256": current_candidate_sha256(),
        "plan_id": plan_id,
        "task_id": task_id,
        "worker_id": worker_id,
        "attempt": attempt,
        "seq_id": max(1, seq_id),
        "ev_ceiling": ADMITTED_EV_CEILING,
        "payload_sha256": sha256_bytes(payload_json.encode("utf-8")),
        "payload_json": payload_json,
    }
    wire = json.dumps(envelope, separators=(",", ":")).encode("utf-8")

    # Always write local WAL/outbox copy first for store-and-forward durability across W2 cutover
    ensure_dirs()
    outbox_path = os.path.join(VAR_CORE, "zenoh_outbox.jsonl")
    with open(outbox_path, "ab") as f:
        f.write(wire + b"\n")

    url = f"{ZENOH_REST_BASE.rstrip('/')}/{topic}"
    req = urllib.request.Request(url, data=wire, method="PUT", headers={"Content-Type": "application/json"})
    zenoh_ok = False
    err_msg = None
    try:
        with urllib.request.urlopen(req, timeout=5.0) as resp:
            zenoh_ok = 200 <= resp.status < 300
    except Exception as exc:
        err_msg = str(exc)

    return {"topic": topic, "seq_id": envelope["seq_id"], "wal_buffered": True, "zenoh_published": zenoh_ok, "error": err_msg, "payload_sha256": envelope["payload_sha256"]}


def mcp_call_tool(tool_name: str, arguments: dict) -> dict:
    """Invoke canonical Gleam/OTP 29 MCP gateway (`tools/uos-mcp-stdio`) over JSON-RPC stdio."""
    reqs = [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": {"name": "uos-core-evo", "version": "1.0.0"}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": {"name": tool_name, "arguments": arguments}},
    ]
    stdin_payload = "\n".join(json.dumps(r, separators=(",", ":")) for r in reqs) + "\n"
    env = os.environ.copy()
    env["TMPDIR"] = TMP_CORE
    env["UOS_MCP_CLIENT_NAME"] = "uos-core-evo"
    proc = subprocess.run(
        [MCP_STDIO],
        input=stdin_payload,
        capture_output=True,
        text=True,
        timeout=30,
        env=env,
    )
    if proc.returncode != 0:
        return {"ok": False, "returncode": proc.returncode, "stderr": proc.stderr.strip()[:400]}
    for line in reversed(proc.stdout.splitlines()):
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
            if msg.get("id") == 2:
                return {"ok": "result" in msg, "response": msg}
        except json.JSONDecodeError:
            continue
    return {"ok": False, "error": "no_id_2_response", "stdout_tail": proc.stdout[-300:]}


def plan_attempt(task_id: str, role: str, attempt: int, failure_kind: str, quota: dict) -> dict:
    clean_id = "".join(c for c in task_id if c.isalnum() or c in "_-")[:48]
    if quota["status"] != "ADMITTED":
        return {
            "action": "JIDOKA_ANDON_HOLD",
            "attempt": attempt,
            "reason": f"HOLD_MARGIN_40PCT:{','.join(quota['violations'])}",
            "zenoh_alert_topic": f"uos/v1/rca/{clean_id}/andon_hold",
        }
    if failure_kind == "safety":
        return {
            "action": "JIDOKA_ANDON_HOLD",
            "attempt": attempt,
            "reason": "HOLD_SAFETY_BOUNDARY_VIOLATION",
            "zenoh_alert_topic": f"uos/v1/rca/{clean_id}/andon_hold",
        }
    if attempt not in (1, 2, 3):
        return {
            "action": "JIDOKA_ANDON_HOLD",
            "attempt": attempt,
            "reason": "HOLD_MAX_3_ATTEMPTS_EXHAUSTED_JIDOKA_ANDON",
            "zenoh_alert_topic": f"uos/v1/rca/{clean_id}/andon_hold",
        }

    zero_or = quota["mode"] in ("zero_openrouter_shift", "zero_openrouter_and_batched_wakeups")
    mcp_tools = ROLE_MCP_WHITELIST.get(role if attempt == 1 else "rca", ROLE_MCP_WHITELIST["impl"])

    if attempt == 1:
        if role == "gate":
            primary, reviewer = "codex:gpt-6.1-terra", "agy:thin-conductor"
        elif role == "fmea" or zero_or:
            primary, reviewer = "pi+google:gemini-4-argon", "codex:gpt-6.1-terra"
        else:
            primary, reviewer = "pi+openrouter:deepseek/deepseek-v4-flash-0731", "codex:gpt-6.1-terra"
        strategy = "fresh_jj_workspace"
        topic_prefix = f"uos/v1/saplan/{clean_id}/a1"
    elif attempt == 2:
        if failure_kind == "wrong_path" or zero_or:
            primary = "pi+google:gemini-4-argon"
            strategy = "quarantine_rollback_stpa_tps_architectural_pivot"
        else:
            primary = "pi+openrouter:deepseek/deepseek-v4-pro-0813"
            strategy = "quarantine_rollback_ach_rca_and_poka_yoke_first"
        reviewer = "codex:gpt-6.1-terra"
        topic_prefix = f"uos/v1/rca/{clean_id}/a2"
    else:
        primary, reviewer = "pi+google:gemini-4-argon", "codex:gpt-6.1-terra"
        strategy = "quarantine_rollback_stpa_tps_architectural_pivot"
        topic_prefix = f"uos/v1/rca/{clean_id}/a3"

    return {
        "action": "EXECUTE_ATTEMPT",
        "attempt": attempt,
        "primary_engine": primary,
        "reviewer_engine": reviewer,
        "timeout_s": ATTEMPT_TIMEOUTS_S[attempt],
        "lease_ttl_s": LEASE_TTL_S,
        "heartbeat_interval_s": HEARTBEAT_S,
        "tool_timeout_s": TOOL_TIMEOUT_S,
        "strategy": strategy,
        "workspace_dir": os.path.join(UOS_ROOT, ".uos-workspaces", f"{clean_id}-a{attempt}"),
        "allowed_mcp_tools": mcp_tools,
        "zenoh_topic_prefix": topic_prefix,
        "pi_isolated_home": PI_ISOLATED_HOME,
    }


def audit_zero_muda() -> dict:
    checks = {}
    for rel, expected_key in [
        (".mcp.json", "uos-gleam"),
        (".gemini/settings.json", "uos-gleam"),
        (".pi/mcp.json", "uos-harness"),
    ]:
        p = os.path.join(WORKSPACE_ROOT, rel)
        if os.path.exists(p):
            d = json.load(open(p, encoding="utf-8"))
            srvs = list((d.get("mcpServers") or {}).keys())
            checks[rel] = {"servers": srvs, "zero_muda": srvs == [expected_key]}
        else:
            checks[rel] = {"servers": [], "zero_muda": False}

    skills_dir = os.path.join(WORKSPACE_ROOT, ".agents", "skills")
    entries = os.listdir(skills_dir) if os.path.isdir(skills_dir) else []
    imported_leaks = [
        e for e in entries
        if os.path.islink(os.path.join(skills_dir, e))
        and "20261025-1953-imported-skills" in os.readlink(os.path.join(skills_dir, e))
    ]
    checks[".agents/skills"] = {
        "active_count": len(entries),
        "unadmitted_imported_symlinks": len(imported_leaks),
        "zero_muda": len(imported_leaks) == 0,
    }
    return checks


