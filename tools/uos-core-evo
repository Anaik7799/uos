def build_worker_command(plan: dict, prompt_text: str) -> list:
    engine = plan["primary_engine"]
    ws = plan["workspace_dir"]
    mcp_patterns = [f"mcp__uos-harness__{t}" for t in plan["allowed_mcp_tools"]]
    tools_arg = ",".join(["read", "edit", "write", "bash", "grep", "find", "ls"] + mcp_patterns)

    if engine.startswith("codex:"):
        return [
            "codex", "exec",
            "-C", ws,
            "-c", "mcp_servers.node_repl.enabled=false",
            prompt_text,
        ]

    provider, model = engine.replace("pi+", "", 1).split(":", 1)
    return [
        "pi",
        "--provider", provider,
        "--model", model,
        "--print",
        "--mode", "json",
        "--no-session",
        "--no-extensions",
        "--no-skills",
        "--skill", os.path.join(UOS_ROOT, ".agents", "skills", "uos-km-triad-brain-memory"),
        "--no-prompt-templates",
        "--no-themes",
        "--mcp-config", os.path.join(PI_ISOLATED_HOME, "mcp.json"),
        "--mcp-project-servers", "allow",
        "--tools", tools_arg,
        prompt_text,
    ]


def cmd_run_task(args: argparse.Namespace) -> int:
    ensure_dirs()
    conn = init_quota_db()
    base_prompt = open(args.prompt_file, encoding="utf-8").read()
    failure_kind = "none"
    last_forensics = ""

    for attempt in (1, 2, 3):
        if not verify_default_at_conservation()["conserved"]:
            failure_kind = "safety"
        quota = get_quota_snapshot(conn)
        plan = plan_attempt(args.task_id, args.role, attempt, failure_kind, quota)

        if plan["action"] != "EXECUTE_ATTEMPT":
            zenoh_publish_signed(
                topic=plan["zenoh_alert_topic"],
                plan_id=args.plan_id,
                task_id=args.task_id,
                worker_id="uos-core-evo",
                attempt=attempt,
                seq_id=quota["last_seq_id"] + attempt,
                payload_obj={"status": "HOLD", "reason": plan["reason"][:160]},
            )
            print(json.dumps(plan, indent=2))
            return 2

        # Clean JJ sibling workspace creation (quarantining/forgetting prior corrupt attempt)
        ws = plan["workspace_dir"]
        ws_name = os.path.basename(ws)
        if os.path.exists(ws):
            subprocess.run(["jj", "-R", UOS_ROOT, "workspace", "forget", ws_name], capture_output=True)
            shutil.rmtree(ws, ignore_errors=True)
        subprocess.run(
            ["jj", "-R", UOS_ROOT, "workspace", "add", "--name", ws_name, "-r", "main", ws],
            check=True,
            capture_output=True,
        )

        # Compose RCA / TPS recovery envelope prompt on Attempts 2 & 3
        if attempt == 1:
            attempt_prompt = base_prompt
        elif attempt == 2:
            attempt_prompt = (
                f"[ATTEMPT 2 — FRACTAL ACH RCA + TPS POKA-YOKE RECOVERY]\n"
                f"Attempt 1 failed in an isolated workspace that has been rolled back cleanly.\n"
                f"Forensics digest:\n{last_forensics[:1500]}\n\n"
                f"MANDATORY STEPS:\n"
                f"1. Run Analysis of Competing Hypotheses (ACH) on the root cause.\n"
                f"2. Write a failing Poka-Yoke regression test FIRST.\n"
                f"3. Implement and verify the clean fix:\n\n{base_prompt}"
            )
        else:
            attempt_prompt = (
                f"[ATTEMPT 3 — STPA/FMEA WRONG-PATH TPS ARCHITECTURAL PIVOT]\n"
                f"Attempts 1 & 2 failed and were rolled back cleanly to `main`.\n"
                f"Prior RCA forensics:\n{last_forensics[:1500]}\n\n"
                f"Re-evaluate architectural assumptions via STPA/FMEA, eliminate the wrong path, "
                f"and execute a minimal verified solution:\n\n{base_prompt}"
            )

        stop_hb = threading.Event()

        def heartbeat_loop(att: int = attempt, pfx: str = plan["zenoh_topic_prefix"]) -> None:
            beat = 0
            while not stop_hb.wait(HEARTBEAT_S):
                beat += 1
                zenoh_publish_signed(
                    topic=f"{pfx}/heartbeat",
                    plan_id=args.plan_id,
                    task_id=args.task_id,
                    worker_id=plan["primary_engine"],
                    attempt=att,
                    seq_id=int(time.time()) + beat,
                    payload_obj={"beat": beat, "lease_ttl_s": LEASE_TTL_S},
                )

        hb_thread = threading.Thread(target=heartbeat_loop, daemon=True)
        hb_thread.start()

        env = os.environ.copy()
        attempt_tmp = os.path.join(TMP_CORE, f"{ws_name}_tmp")
        os.makedirs(attempt_tmp, mode=0o700, exist_ok=True)
        env["TMPDIR"] = attempt_tmp
        env["PI_CODING_AGENT_DIR"] = PI_ISOLATED_HOME

        cmd = build_worker_command(plan, attempt_prompt)
        try:
            proc = subprocess.run(
                cmd,
                cwd=ws,
                env=env,
                capture_output=True,
                text=True,
                timeout=plan["timeout_s"],
            )
            rc = proc.returncode
            out_tail = (proc.stdout[-800:] + "\n" + proc.stderr[-800:]).strip()
        except subprocess.TimeoutExpired as exc:
            rc = 124
            out_tail = f"timeout_expired_after_{plan['timeout_s']}s: {exc}"
        finally:
            stop_hb.set()
            shutil.rmtree(attempt_tmp, ignore_errors=True)

        if rc == 0 and verify_default_at_conservation()["conserved"]:
            digest_obj = {
                "schema": "uos.core_evo.digest.v1",
                "ev_ceiling": ADMITTED_EV_CEILING,
                "task": args.task_id[:32],
                "attempt": attempt,
                "engine": plan["primary_engine"],
                "status": "PASS",
                "ws": ws_name,
            }
            zenoh_publish_signed(
                topic=f"{plan['zenoh_topic_prefix']}/receipt",
                plan_id=args.plan_id,
                task_id=args.task_id,
                worker_id=plan["primary_engine"],
                attempt=attempt,
                seq_id=int(time.time()),
                payload_obj=digest_obj,
            )
            print(json.dumps(digest_obj))
            return 0

        # Failure / corruption: record forensics to Zenoh & roll back taint before next attempt
        last_forensics = f"rc={rc}\n{out_tail}"
        failure_kind = "wrong_path" if attempt == 2 else "transient"
        zenoh_publish_signed(
            topic=f"uos/v1/rca/{ws_name}/a{attempt}/forensics",
            plan_id=args.plan_id,
            task_id=args.task_id,
            worker_id=plan["primary_engine"],
            attempt=attempt,
            seq_id=int(time.time()),
            payload_obj={"rc": rc, "tail": out_tail[:600]},
        )
        subprocess.run(["jj", "-R", UOS_ROOT, "workspace", "forget", ws_name], capture_output=True)
        shutil.rmtree(ws, ignore_errors=True)

    # All 3 attempts exhausted -> Fail-closed Jidoka Andon HOLD
    hold_plan = plan_attempt(args.task_id, args.role, 4, failure_kind, get_quota_snapshot(conn))
    zenoh_publish_signed(
        topic=hold_plan["zenoh_alert_topic"],
        plan_id=args.plan_id,
        task_id=args.task_id,
        worker_id="uos-core-evo",
        attempt=4,
        seq_id=int(time.time()),
        payload_obj={"status": "HOLD", "reason": hold_plan["reason"]},
    )
    print(json.dumps(hold_plan))
    return 2


