    mcp_fractal = mcp_call_tool("fractal_status", {})
    mcp_metabolic = mcp_call_tool("metabolic_state", {})
    margin_bps = quota["min_remaining_margin_bps"]
    if quota["status"] != "ADMITTED":
        regime = "torpor_margin_40_hold"
    elif margin_bps > 5500:
        regime = "anabolic_parallel"
    elif margin_bps >= 4500:
        regime = "homeostatic_zero_or_shift"
    else:
        regime = "catabolic_critical_only"

    v_now = 100 * args.failing_tasks + 40 * args.stale_leases + 15 * args.open_issues + 80 * args.drift_events
    dv = v_now - args.v_prev
    stable = (v_now == 0) or (dv <= 0)
    layers = [f"#fractal-l{i}" for i in range(10)]
    summary = {
        "schema": "uos.core_evo.biomorphic_fractal.v1",
        "metabolic_regime": regime,
        "mcp_fractal_ok": mcp_fractal["ok"],
        "mcp_metabolic_ok": mcp_metabolic["ok"],
        "fractal_layers_l0_l9": layers,
        "poodavr_stages": ["Predict", "Observe", "Orient", "Decide", "Act", "Verify", "Reflect"],
        "lyapunov": {"v_prev": args.v_prev, "v_now": v_now, "delta_v": dv, "is_monotone_stable": stable},
    }
    pub = zenoh_publish_signed(
        topic="uos/v1/biomorphic/homeostasis/snapshot",
        plan_id="uos/agy-fractal-issue-resolution-master/20261101-1454",
        task_id="biomorphic-fractal",
        worker_id="uos-core-evo",
        attempt=1,
        seq_id=int(time.time()),
        payload_obj={"regime": regime, "v_now": v_now, "dv": dv, "stable": stable},
    )
    summary["zenoh_pub"] = pub
    print(json.dumps(summary, indent=2))
    return 0 if stable and quota["status"] == "ADMITTED" else 2


def main() -> int:
    parser = argparse.ArgumentParser(description="UOS-CORE-EVO Zero-Muda Core Dev, Hive, Biomorphic, Fractal & Evolution System")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("preflight", help="Run Zero-Muda MCP + Zenoh + Quota + Conservation preflight")
    sub.add_parser("hive-status", help="Inspect 5-Caste Holonic Hive Heijunka & MCP/Zenoh binding")

    p_bf = sub.add_parser("biomorphic-fractal", help="Evaluate Metabolic ATP, Lyapunov dV/dt & L0..L9 POODAVR state")
    p_bf.add_argument("--v-prev", type=int, default=600)
    p_bf.add_argument("--failing-tasks", type=int, default=0)
    p_bf.add_argument("--stale-leases", type=int, default=0)
    p_bf.add_argument("--open-issues", type=int, default=29)
    p_bf.add_argument("--drift-events", type=int, default=0)

    p_q = sub.add_parser("quota", help="Query or append 40-pct-margin sliding-window quota ledger")
    p_q.add_argument("--engine", default="uos-core-evo")
    p_q.add_argument("--task-id", default="probe")
    p_q.add_argument("--record-agy-bps", type=int, default=0)
    p_q.add_argument("--record-or-nd", type=int, default=0)
    p_q.add_argument("--note", default="observation")

    p_pa = sub.add_parser("plan-attempt", help="Compute deterministic engine, timeout & recovery plan")
    p_pa.add_argument("task_id")
    p_pa.add_argument("role", choices=["impl", "rca", "gate", "fmea"])
    p_pa.add_argument("attempt", type=int)
    p_pa.add_argument("--failure", default="none", choices=["none", "transient", "corruption", "wrong_path", "safety"])

    p_rt = sub.add_parser("run-task", help="Execute 3-attempt self-healing task in isolated JJ workspaces")
    p_rt.add_argument("plan_id")
    p_rt.add_argument("task_id")
    p_rt.add_argument("role", choices=["impl", "rca", "gate", "fmea"])
    p_rt.add_argument("prompt_file")

    args = parser.parse_args()
    if args.cmd == "preflight":
        return cmd_preflight(args)
    if args.cmd == "hive-status":
        return cmd_hive_status(args)
    if args.cmd == "biomorphic-fractal":
        return cmd_biomorphic_fractal(args)
    if args.cmd == "quota":
        return cmd_quota(args)
    if args.cmd == "plan-attempt":
        return cmd_plan_attempt(args)
    if args.cmd == "run-task":
        return cmd_run_task(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
