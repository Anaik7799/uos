    Quota = {quota_snapshot, ${b5}, ${b24}, ${b7d}, ${or_nd}},
    RoleTerm = case \"${role}\" of
      \"rca\" -> rca_tps_role;
      \"gate\" -> sovereign_gate_role;
      \"fmea\" -> fmea_formal_role;
      _ -> impl_role
    end,
    SysMod = 'cepaf_gleam@ecology@core_systems_engineering',
    Plan = SysMod:handle_system_error(<<\"${task_id}\">>, RoleTerm, ${attempt}, {err_mode_transient_test_or_build, <<\"plan_probe\">>}, Quota),
    Out = #{
      <<\"schema\">> => <<\"uos.core_evo.plan_attempt.v5\">>,
      <<\"task_id\">> => <<\"${task_id}\">>,
      <<\"role\">> => <<\"${role}\">>,
      <<\"attempt\">> => ${attempt},
      <<\"decision\">> => iolist_to_binary(io_lib:format(\"~p\", [element(1, Plan)]))
    },
    io:put_chars([json:encode(Out), <<\"\n\">>]),
    halt(0).
  "
}

cmd_run_task() {
  local plan_id="${1:?plan_id required}" task_id="${2:?task_id required}" role="${3:-impl}" prompt_file="${4:-}"
  printf '{"schema":"uos.core_evo.run_task.v5","plan_id":"%s","task_id":"%s","role":"%s","prompt_file":"%s","authority":"sa-plan","status":"delegated_to_sa_plan"}\n' \
    "${plan_id}" "${task_id}" "${role}" "${prompt_file}"
}

usage() {
  cat <<'EOF'
Usage: tools/uos-core-evo <subcommand> [options]
Subcommands:
  preflight              Run Zero-Muda OTP 29 + MCP + Quota + Supervised 40-Actor preflight
  dashboard [--plain|--json] Render TUI or JSON summary of /core-evo Cockpit & #km-triad
  hive-status            Inspect 5-Caste Holonic Hive Heijunka & token budget allocation
  systems-engineering    Verify 17-Aspect, Sheaf, Stan, 11-Domain Rete-UL, FPP/SysML & 8 Bionic Services
  simulate-verify        Simulate 24 epochs x 170 Fractal Holons (4,080 states, 12 invariants)
  fpp-actor-mesh         Verify all 40 OTP 29 FPP actors + persistent OneForOne supervisor + Ed25519 Zenoh
  biomorphic-fractal     Evaluate Metabolic ATP & Lyapunov dV/dt stability
  quota                  Query or record 40%-margin sliding-window quota ledger
  plan-attempt           Compute deterministic 3-attempt Jidoka self-healing plan
  run-task               Delegate Sa-plan fenced task execution
EOF
}

subcmd="${1:-}"
if [[ -z "${subcmd}" ]]; then
  usage >&2
  exit 1
fi
shift

case "${subcmd}" in
  preflight) cmd_preflight "$@" ;;
  dashboard) cmd_dashboard "$@" ;;
  hive-status) cmd_hive_status "$@" ;;
  systems-engineering) cmd_systems_engineering "$@" ;;
  simulate-verify) cmd_simulate_verify "$@" ;;
  fpp-actor-mesh) cmd_fpp_actor_mesh "$@" ;;
  biomorphic-fractal) cmd_biomorphic_fractal "$@" ;;
  quota) cmd_quota "$@" ;;
  plan-attempt) cmd_plan_attempt "$@" ;;
  run-task) cmd_run_task "$@" ;;
  -h|--help|help) usage ;;
  *)
    printf 'Unknown subcommand: %s\n' "${subcmd}" >&2
    usage >&2
    exit 1
    ;;
esac
