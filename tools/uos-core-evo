cmd_biomorphic_fractal() {
  local v_prev=600 failing=0 stale=0 open_issues=0 drift=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --v-prev) v_prev="$2"; shift 2 ;;
      --failing-tasks) failing="$2"; shift 2 ;;
      --stale-leases) stale="$2"; shift 2 ;;
      --open-issues) open_issues="$2"; shift 2 ;;
      --drift-events) drift="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  IFS='|' read -r b5 b24 b7d or_nd <<<"$(read_quota_csv)"
  run_otp29_eval "
    Quota = {quota_snapshot, ${b5}, ${b24}, ${b7d}, ${or_nd}},
    SysMod = 'cepaf_gleam@ecology@core_systems_engineering',
    Bionic = SysMod:evaluate_bionic_services_suite(Quota, 0.25, 0.0, 0.28, false),
    VNow = (${failing} * 100) + (${stale} * 50) + (${open_issues} * 10) + (${drift} * 80),
    DeltaV = VNow - ${v_prev},
    Out = #{
      <<\"schema\">> => <<\"uos.core_evo.biomorphic_fractal.v5\">>,
      <<\"lyapunov_v_prev\">> => ${v_prev},
      <<\"lyapunov_v_now\">> => VNow,
      <<\"lyapunov_delta_v\">> => DeltaV,
      <<\"lyapunov_decreasing\">> => (DeltaV =< 0),
      <<\"bionic_services_online\">> => element(8, Bionic),
      <<\"admitted_ev_ceiling\">> => ${ADMITTED_EV_CEILING}
    },
    io:put_chars([json:encode(Out), <<\"\n\">>]),
    halt(0).
  "
}

cmd_quota() {
  local engine="uos-core-evo" task_id="probe" agy_bps=0 or_nd=0 note="observation"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --engine) engine="$2"; shift 2 ;;
      --task-id) task_id="$2"; shift 2 ;;
      --record-agy-bps) agy_bps="$2"; shift 2 ;;
      --record-or-nd) or_nd="$2"; shift 2 ;;
      --note) note="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  init_quota_db
  if [[ "${agy_bps}" -ne 0 || "${or_nd}" -ne 0 ]]; then
    local now
    now="$(date +%s)"
    local clean_engine="${engine//\'/}"
    local clean_task="${task_id//\'/}"
    local clean_note="${note//\'/}"
    sqlite3 "${QUOTA_DB}" "INSERT INTO quota_events(ts_epoch, engine, task_id, agy_bps_delta, openrouter_nanodollars_delta, note) VALUES (${now}, '${clean_engine}', '${clean_task}', ${agy_bps}, ${or_nd}, '${clean_note}');"
  fi
  IFS='|' read -r b5 b24 b7d sum_or <<<"$(read_quota_csv)"
  run_otp29_eval "
    Quota = {quota_snapshot, ${b5}, ${b24}, ${b7d}, ${sum_or}},
    EvoMod = 'cepaf_gleam@ecology@core_evolution',
    {StatusBin, RemBps} = case EvoMod:evaluate_quota_margin(Quota) of
      {quota_admitted, _, R, _} -> {<<\"ADMITTED_MARGIN_OK\">>, R};
      {quota_hold_margin40_pct, _} -> {<<\"HOLD_MARGIN_40PCT\">>, 0}
    end,
    Out = #{
      <<\"schema\">> => <<\"uos.core_evo.quota.v5\">>,
      <<\"status\">> => StatusBin,
      <<\"agy_5h_bps\">> => ${b5},
      <<\"agy_24h_bps\">> => ${b24},
      <<\"agy_7d_bps\">> => ${b7d},
      <<\"remaining_margin_bps\">> => RemBps,
      <<\"mandatory_margin_bps\">> => 4000,
      <<\"hard_ceiling_bps\">> => 6000,
      <<\"openrouter_24h_nanodollars\">> => ${sum_or}
    },
    io:put_chars([json:encode(Out), <<\"\n\">>]),
    halt(0).
  "
}

