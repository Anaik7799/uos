resolve_ebin_glob() {
  if [[ -n "${UOS_COCKPIT_RELEASE:-}" && -d "${UOS_COCKPIT_RELEASE}/apps/cepaf_gleam/ebin" ]]; then
    printf '%s/apps/*/ebin' "${UOS_COCKPIT_RELEASE%/}"
  elif [[ -d "${WORKSPACE_ROOT}/apps/cepaf_gleam/build/dev/erlang/cepaf_gleam/ebin" ]]; then
    printf '%s/apps/cepaf_gleam/build/dev/erlang/*/ebin' "${WORKSPACE_ROOT}"
  else
    printf '%s/apps/cepaf_gleam/build/dev/erlang/*/ebin' "${CANONICAL_UOS}"
  fi
}

EBIN_GLOB="$(resolve_ebin_glob)"

init_quota_db() {
  mkdir -p "${STATE_DIR}"
  sqlite3 "${QUOTA_DB}" <<'SQL' >/dev/null
PRAGMA journal_mode=WAL;
CREATE TABLE IF NOT EXISTS quota_events (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts_epoch INTEGER NOT NULL,
  engine TEXT NOT NULL,
  task_id TEXT NOT NULL,
  agy_bps_delta INTEGER NOT NULL DEFAULT 0,
  openrouter_nanodollars_delta INTEGER NOT NULL DEFAULT 0,
  note TEXT NOT NULL DEFAULT ''
);
CREATE INDEX IF NOT EXISTS idx_quota_ts ON quota_events(ts_epoch);
SQL
}

read_quota_csv() {
  init_quota_db
  local now
  now="$(date +%s)"
  sqlite3 -separator '|' "${QUOTA_DB}" "
    SELECT
      COALESCE((SELECT SUM(agy_bps_delta) FROM quota_events WHERE ts_epoch >= ${now} - 18000), 0),
      COALESCE((SELECT SUM(agy_bps_delta) FROM quota_events WHERE ts_epoch >= ${now} - 86400), 0),
      COALESCE((SELECT SUM(agy_bps_delta) FROM quota_events WHERE ts_epoch >= ${now} - 604800), 0),
      COALESCE((SELECT SUM(openrouter_nanodollars_delta) FROM quota_events WHERE ts_epoch >= ${now} - 86400), 0);
  "
}

probe_mcp_tool() {
  local tool_name="$1"
  local args_json="${2-}"
  if [[ -z "${args_json}" ]]; then
    args_json="{}"
  fi
  local out
  out="$(
    {
      printf '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"uos-core-evo","version":"5.0.0"}}}\n'
      printf '{"jsonrpc":"2.0","method":"notifications/initialized","params":{}}\n'
      printf '{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"%s","arguments":%s}}\n' "${tool_name}" "${args_json}"
      sleep 1
    } | timeout 12s "${MCP_STDIO}" 2>/dev/null || true
  )"
  if [[ "${out}" == *'"id":2'* && "${out}" == *'"result"'* && "${out}" != *'"isError":true'* ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

run_otp29_eval() {
  local erl_expr="$1"
  "${OTP29_ERL}" -noshell -eval "
    inets:start(),
    Paths = filelib:wildcard(\"${EBIN_GLOB}\"),
    ok = code:add_pathsa(Paths),
    ${erl_expr}
  "
}

