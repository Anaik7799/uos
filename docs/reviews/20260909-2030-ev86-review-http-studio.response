&lt;!-- Real-time Web Audio API JavaScript Implementation --&gt;
&lt;script&gt;
// Audio Context Singleton
let audioCtx = null;

function getAudioContext() {
  if (!audioCtx) {
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    audioCtx = new AudioContextClass();
  }
  if (audioCtx.state === &#39;suspended&#39;) {
    audioCtx.resume();
  }
  return audioCtx;
}

// -------------------------------------------------------------
// 1. TANPURA QUAD-DRONE SYNTHESIZER
// -------------------------------------------------------------
let isTanpuraRunning = false;
let tanpuraTimer = null;
let tanpuraMasterGain = null;
const tanpuraPitches = [
  { note: &#39;Pa&#39;, freq: 196.219, oct: 3 },
  { note: &#39;Sa&#39;, freq: 261.626, oct: 4 },
  { note: &#39;Sa&#39;, freq: 261.626, oct: 4 },
  { note: &#39;Kharaj Sa&#39;, freq: 130.813, oct: 3 }
];
let currentString = 0;

function toggleTanpura() {
  const btn = document.getElementById(&#39;btn-tanpura-toggle&#39;);
  const ctx = getAudioContext();
  
  if (!isTanpuraRunning) {
    isTanpuraRunning = true;
    btn.textContent = &#39;STOP DRONE&#39;;
    btn.style.background = &#39;#da3633&#39;;
    
    if (!tanpuraMasterGain) {
      tanpuraMasterGain = ctx.createGain();
      const vol = document.getElementById(&#39;tanpura-vol&#39;).value;
      tanpuraMasterGain.gain.setValueAtTime(parseFloat(vol), ctx.currentTime);
      tanpuraMasterGain.connect(ctx.destination);
    }
    
    currentString = 0;
    pluckNextTanpuraString();
  } else {
    isTanpuraRunning = false;
    btn.textContent = &#39;START DRONE&#39;;
    btn.style.background = &#39;#238636&#39;;
    if (tanpuraTimer) clearTimeout(tanpuraTimer);
  }
}

function setTanpuraVolume(val) {
  if (tanpuraMasterGain &amp;&amp; audioCtx) {
    tanpuraMasterGain.gain.setValueAtTime(parseFloat(val), audioCtx.currentTime);
  }
}

function pluckNextTanpuraString() {
  if (!isTanpuraRunning) return;
  const ctx = getAudioContext();
  const pitch = tanpuraPitches[currentString];
  
  // Pluck individual string with non-linear Jawari overtones
  const osc = ctx.createOscillator();
  const oscGain = ctx.createGain();
  
  // Complex sawtooth with slight detune creates authentic thread buzzing
  osc.type = &#39;sawtooth&#39;;
  osc.frequency.setValueAtTime(pitch.freq, ctx.currentTime);
  
  // Low-pass filter simulating the curved wooden bridge (Jawari)
  const filter = ctx.createBiquadFilter();
  filter.type = &#39;lowpass&#39;;
  filter.frequency.setValueAtTime(pitch.freq * 12, ctx.currentTime);
  filter.frequency.exponentialRampToValueAtTime(pitch.freq * 2.5, ctx.currentTime + 3.5);
  filter.Q.setValueAtTime(4.0, ctx.currentTime);
  
  // Envelope
  oscGain.gain.setValueAtTime(0.001, ctx.currentTime);
  oscGain.gain.linearRampToValueAtTime(0.3, ctx.currentTime + 0.08);
  oscGain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 4.0);
  
  osc.connect(filter);
  filter.connect(oscGain);
  oscGain.connect(tanpuraMasterGain);
  
  osc.start(ctx.currentTime);
  osc.stop(ctx.currentTime + 4.2);
  
  currentString = (currentString + 1) % tanpuraPitches.length;
  tanpuraTimer = setTimeout(pluckNextTanpuraString, 1100);
}

// -------------------------------------------------------------
// 2. TEENTAAL TABLA LOOP (16 BEATS)
// -------------------------------------------------------------
let isTablaRunning = false;
let tablaTimer = null;
let currentBeat = 0;
let tablaBpm = 80;

const teentaalBols = [
  { num: 1, bol: &#39;Dhā&#39;, type: &#39;sam&#39;, bayan: true, dayan: true, mark: &#39;X&#39; },
  { num: 2, bol: &#39;Dhin&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 3, bol: &#39;Dhin&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 4, bol: &#39;Dhā&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 5, bol: &#39;Dhā&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;2&#39; },
  { num: 6, bol: &#39;Dhin&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 7, bol: &#39;Dhin&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 8, bol: &#39;Dhā&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 9, bol: &#39;Dhā&#39;, type: &#39;khali&#39;, bayan: false, dayan: true, mark: &#39;0&#39; },
  { num: 10, bol: &#39;Tin&#39;, type: &#39;khali&#39;, bayan: false, dayan: true, mark: &#39;&#39; },
  { num: 11, bol: &#39;Tin&#39;, type: &#39;khali&#39;, bayan: false, dayan: true, mark: &#39;&#39; },
  { num: 12, bol: &#39;Tā&#39;, type: &#39;khali&#39;, bayan: false, dayan: true, mark: &#39;&#39; },
  { num: 13, bol: &#39;Tā&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;3&#39; },
  { num: 14, bol: &#39;Dhin&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 15, bol: &#39;Dhin&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; },
  { num: 16, bol: &#39;Dhā&#39;, type: &#39;tali&#39;, bayan: true, dayan: true, mark: &#39;&#39; }
];

function toggleTabla() {
  const btn = document.getElementById(&#39;btn-tabla-toggle&#39;);
  if (!isTablaRunning) {
    isTablaRunning = true;
    btn.textContent = &#39;STOP TABLA&#39;;
    btn.style.background = &#39;#da3633&#39;;
    currentBeat = 0;
    playNextTablaBeat();
  } else {
    isTablaRunning = false;
    btn.textContent = &#39;START TABLA&#39;;
    btn.style.background = &#39;#238636&#39;;
    if (tablaTimer) clearTimeout(tablaTimer);
    document.getElementById(&#39;beat-num&#39;).textContent = &#39;-&#39;;
    document.getElementById(&#39;beat-bol&#39;).textContent = &#39;Ready&#39;;
  }
}

function setTablaBpm(bpm) {
  tablaBpm = parseInt(bpm, 10);
  document.getElementById(&#39;bpm-readout&#39;).textContent = bpm + &#39; BPM&#39;;
}

function playNextTablaBeat() {
  if (!isTablaRunning) return;
  const ctx = getAudioContext();
  const beat = teentaalBols[currentBeat];
  
  // UI Update
  document.getElementById(&#39;beat-num&#39;).textContent = beat.num + (beat.mark ? &#39; (&#39; + beat.mark + &#39;)&#39; : &#39;&#39;);
  document.getElementById(&#39;beat-bol&#39;).textContent = beat.bol;
  
  // Synthesize Dayan (Treble drum tuned to Sa = 261.63 Hz)
  if (beat.dayan) {
    const dOsc = ctx.createOscillator();
    const dGain = ctx.createGain();
    dOsc.type = &#39;sine&#39;;
    dOsc.frequency.setValueAtTime(261.63, ctx.currentTime);
    
    // Slight pitch rise and harmonic ring
    dOsc.frequency.exponentialRampToValueAtTime(268.0, ctx.currentTime + 0.03);
    dOsc.frequency.exponentialRampToValueAtTime(261.63, ctx.currentTime + 0.3);
    
    dGain.gain.setValueAtTime(0.25, ctx.currentTime);
    dGain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.28);
    
    dOsc.connect(dGain);
    dGain.connect(ctx.destination);
    dOsc.start(ctx.currentTime);
    dOsc.stop(ctx.currentTime + 0.3);
  }
  
  // Synthesize Bayan (Bass drum with pitch modulation &quot;Ghe&quot; downward slide)
  if (beat.bayan) {
    const bOsc = ctx.createOscillator();
    const bGain = ctx.createGain();
    bOsc.type = &#39;triangle&#39;;
    
    // Pitch drops from 110Hz to 65Hz simulating the heel of the palm pressure
    bOsc.frequency.setValueAtTime(110.0, ctx.currentTime);
    bOsc.frequency.exponentialRampToValueAtTime(65.0, ctx.currentTime + 0.35);
    
    bGain.gain.setValueAtTime(0.4, ctx.currentTime);
    bGain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
    
    bOsc.connect(bGain);
    bGain.connect(ctx.destination);
    bOsc.start(ctx.currentTime);
    bOsc.stop(ctx.currentTime + 0.42);
  }
  
  currentBeat = (currentBeat + 1) % 16;
  const intervalMs = (60.0 / tablaBpm) * 1000;
  tablaTimer = setTimeout(playNextTablaBeat, intervalMs);
}

// -------------------------------------------------------------
// 3. BĀNSURĪ VIRTUAL FLUTE SYNTHESIZER WITH MEEND &amp; ANDOLAN
// -------------------------------------------------------------
let bansuriOsc = null;
let bansuriGain = null;
let lfoOsc = null;
let lastFreq = 261.63;

function playSwara(name, freq, ratio, cents) {
  const ctx = getAudioContext();
  
  // UI Telemetry update
  document.getElementById(&#39;current-swara&#39;).textContent = name;
  document.getElementById(&#39;current-freq&#39;).textContent = freq.toFixed(2) + &#39; Hz&#39;;
  document.getElementById(&#39;current-ratio&#39;).textContent = ratio;
  document.getElementById(&#39;current-cents&#39;).textContent = cents;
  
  // Continuous Monophonic Flute Voice with 140ms Meend portamento glide
  if (!bansuriOsc) {
    bansuriOsc = ctx.createOscillator();
    bansuriGain = ctx.createGain();
    
    // Triangle wave provides soft, hollow bamboo harmonics
    bansuriOsc.type = &#39;triangle&#39;;
    bansuriOsc.frequency.setValueAtTime(freq, ctx.currentTime);
    
    // 5.2 Hz Andolan vibrato LFO
    lfoOsc = ctx.createOscillator();
    const lfoGain = ctx.createGain();
    lfoOsc.frequency.setValueAtTime(5.2, ctx.currentTime);
    lfoGain.gain.setValueAtTime(2.5, ctx.currentTime); // ~12 cents modulation
    lfoOsc.connect(lfoGain);
    lfoGain.connect(bansuriOsc.frequency);
    lfoOsc.start(ctx.currentTime);
    
    // Envelope
    bansuriGain.gain.setValueAtTime(0.001, ctx.currentTime);
    bansuriGain.gain.linearRampToValueAtTime(0.35, ctx.currentTime + 0.08);
    
    bansuriOsc.connect(bansuriGain);
    bansuriGain.connect(ctx.destination);
    bansuriOsc.start(ctx.currentTime);
  } else {
    // Portamento Meend glide from last frequency to new frequency
    bansuriOsc.frequency.cancelScheduledValues(ctx.currentTime);
    bansuriOsc.frequency.setValueAtTime(lastFreq, ctx.currentTime);
    bansuriOsc.frequency.exponentialRampToValueAtTime(freq, ctx.currentTime + 0.14);
    
    // Refresh gain envelope
    bansuriGain.gain.cancelScheduledValues(ctx.currentTime);
    bansuriGain.gain.setValueAtTime(0.35, ctx.currentTime);
  }
  
  lastFreq = freq;
  
  // Gentle release if no subsequent note is pressed within 1.2 seconds
  bansuriGain.gain.setValueAtTime(0.35, ctx.currentTime + 0.8);
  bansuriGain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 1.4);
}

// -------------------------------------------------------------
// 4. PRESET BANDISH MELODIES (STHAYI, ANTARA, DRUT TAAN)
// -------------------------------------------------------------
const sthayiPhrase = [
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 600 },
  { name: &#39;Ma&#39;, freq: 348.83, ratio: &#39;4/3&#39;, cents: &#39;498.04 cents&#39;, dur: 450 },
  { name: &#39;Re&#39;, freq: 294.33, ratio: &#39;9/8&#39;, cents: &#39;203.91 cents&#39;, dur: 600 },
  { name: &#39;Pa&#39;, freq: 392.44, ratio: &#39;3/2&#39;, cents: &#39;701.96 cents&#39;, dur: 450 },
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 450 },
  { name: &#39;Sa\&#39;&#39;, freq: 523.25, ratio: &#39;2/1&#39;, cents: &#39;1200.00 cents&#39;, dur: 900 },
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 450 },
  { name: &#39;Ma&#39;, freq: 348.83, ratio: &#39;4/3&#39;, cents: &#39;498.04 cents&#39;, dur: 450 },
  { name: &#39;Re&#39;, freq: 294.33, ratio: &#39;9/8&#39;, cents: &#39;203.91 cents&#39;, dur: 600 },
  { name: &#39;Sa&#39;, freq: 261.63, ratio: &#39;1/1&#39;, cents: &#39;0 cents&#39;, dur: 1200 }
];

const antaraPhrase = [
  { name: &#39;Ma&#39;, freq: 348.83, ratio: &#39;4/3&#39;, cents: &#39;498.04 cents&#39;, dur: 400 },
  { name: &#39;Pa&#39;, freq: 392.44, ratio: &#39;3/2&#39;, cents: &#39;701.96 cents&#39;, dur: 400 },
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 600 },
  { name: &#39;Sa\&#39;&#39;, freq: 523.25, ratio: &#39;2/1&#39;, cents: &#39;1200.00 cents&#39;, dur: 800 },
  { name: &#39;Re&#39;, freq: 294.33 * 2, ratio: &#39;9/4&#39;, cents: &#39;1403.91 cents&#39;, dur: 500 },
  { name: &#39;Sa\&#39;&#39;, freq: 523.25, ratio: &#39;2/1&#39;, cents: &#39;1200.00 cents&#39;, dur: 600 },
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 500 },
  { name: &#39;Pa&#39;, freq: 392.44, ratio: &#39;3/2&#39;, cents: &#39;701.96 cents&#39;, dur: 500 },
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 800 }
];

const drutTaan = [
  { name: &#39;Sa&#39;, freq: 261.63, ratio: &#39;1/1&#39;, cents: &#39;0 cents&#39;, dur: 220 },
  { name: &#39;Re&#39;, freq: 294.33, ratio: &#39;9/8&#39;, cents: &#39;203.91 cents&#39;, dur: 220 },
  { name: &#39;Ma&#39;, freq: 348.83, ratio: &#39;4/3&#39;, cents: &#39;498.04 cents&#39;, dur: 220 },
  { name: &#39;Pa&#39;, freq: 392.44, ratio: &#39;3/2&#39;, cents: &#39;701.96 cents&#39;, dur: 220 },
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 220 },
  { name: &#39;Sa\&#39;&#39;, freq: 523.25, ratio: &#39;2/1&#39;, cents: &#39;1200.00 cents&#39;, dur: 350 },
  { name: &#39;Sa\&#39;&#39;, freq: 523.25, ratio: &#39;2/1&#39;, cents: &#39;1200.00 cents&#39;, dur: 220 },
  { name: &#39;Dha&#39;, freq: 436.04, ratio: &#39;5/3&#39;, cents: &#39;884.36 cents&#39;, dur: 220 },
  { name: &#39;Pa&#39;, freq: 392.44, ratio: &#39;3/2&#39;, cents: &#39;701.96 cents&#39;, dur: 220 },
  { name: &#39;Ma&#39;, freq: 348.83, ratio: &#39;4/3&#39;, cents: &#39;498.04 cents&#39;, dur: 220 },
  { name: &#39;Re&#39;, freq: 294.33, ratio: &#39;9/8&#39;, cents: &#39;203.91 cents&#39;, dur: 220 },
  { name: &#39;Sa&#39;, freq: 261.63, ratio: &#39;1/1&#39;, cents: &#39;0 cents&#39;, dur: 800 }
];

function playSequence(phrase) {
  let idx = 0;
  function step() {
    if (idx &gt;= phrase.length) return;
    const note = phrase[idx];
    playSwara(note.name, note.freq, note.ratio, note.cents);
    idx++;
    setTimeout(step, note.dur);
  }
  step();
}

function playSthayiMelody() { playSequence(sthayiPhrase); }
function playAntaraMelody() { playSequence(antaraPhrase); }
function playTaanMelody() { playSequence(drutTaan); }
&lt;/script&gt;

