  "findings": [
    {
      "id": "EV2-R1",
      "severity": "P2",
      "title": "Deadline bypass after early EOF",
      "source": "tools/ev02_governance/run_checks.ml",
      "reproduced": true,
      "observation": "seconds0.1 child closes both streams then sleeps0.7. Actual Exited0 at0.748545885s; first run0.7583s. Both EOF branch executes blocking waitpid without deadline checks.",
      "repair_boundary": "Poll process exit under monotonic deadline even with empty read set; bounded cleanup and real abnormal state."
    },
    {
      "id": "EV2-R2",
      "severity": "P2",
      "title": "Timeout leaves descendant effects and reader descriptors",
      "source": "tools/ev02_governance/run_checks.ml",
      "reproduced": true,
      "observation": "Timeout returned0.114098s, FDcount6→8. Descendant holding writers created a private marker after return. Both finite child paths terminated naturally within1s. Runner only kills direct pid and returns without guaranteed pipe close.",
      "repair_boundary": "Isolate process group, kill/reap and close all owned descriptors on every outcome; explicit cleanup-unknown if needed."
    },
    {
      "id": "EV2-R3",
      "severity": "P2",
      "title": "Unsafe old policy observation remains callable",
      "source": "tools/ev02_governance/policy_surface_gate.ml",
      "reproduced": true,
      "observation": "--observe on private FIFO rule blocks in open_in_bin; outer native monotonic deadline0.3s terminates124 at0.3034s. New run_checks excludes this observation but CLI remains exposed with unbounded directory/TOML reads and symlink-following open.",
      "repair_boundary": "Remove/refuse obsolete observe path or reuse bounded regular-file observer; do not infer safety from exclusion from this one harness."
    },
    {
      "id": "EV2-R4",
      "severity": "P2",
      "title": "Claimed supporting source clauses are hardcoded",
      "source": "tools/ev02_governance/directive_mapping_gate.ml",
      "reproduced": true,
      "observation": "Synthetic38-ID TOML explicitly says format_mandate=COUNTERFACTUAL/status=REVOKED_SYNTHETIC. Output still claims YYYYMMDD-HHSS-/timestamp-check and CLASSIFIED_MAPPED/active from constants selected only by ID. Overall HOLD stays, but supporting source attribution is false.",
      "repair_boundary": "Derive clauses from actual parsed/hash-bound source or label them expected/unverified template; retain HOLD and missing lineage."
    }
  ],
  "other_observations": [
    "Existing7-case harness selftest passes despite independent deadline/cleanup failures",
    "Actual author summary has4 complete parseable JSON stdout records and all8 stream digests matched; summary.valid means expected report shape/HOLD, not governance approval",
    "Per-stream1MiB limit allows observed1600454 aggregate bytes. Inner drain has no deadline check, but accepted reads are byte-capped; do not describe it as infinitely unbounded",
    "Deadline uses Unix.gettimeofday, susceptible to clock adjustment; static finding only, no host clock changed",
    "source_commit in summary is caller-provided unvalidated label; current e11692 bytes independently pinned here, no producer/candidate authentication claimed",
