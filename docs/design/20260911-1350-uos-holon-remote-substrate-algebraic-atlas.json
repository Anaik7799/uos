  "scott_domain_spec": {
    "cpo_name": "SubstrateInformationDomain (D_S, <=)",
    "bottom": "Bot (uninitialized)",
    "top": "RatifiedFullEvolution",
    "ordering_rules": [
      "Bot <= s for all s in D_S",
      "s <= Top for all s in D_S",
      "s1 <= s2 iff s1.cores <= s2.cores and s1.mem <= s2.mem and s1.evo_score <= s2.evo_score"
    ],
    "join_semantics": "Supremum s1 U s2 computes the upper bound of environmental capabilities",
    "kleene_fixed_point": "fix(Phi) = U_{n>=0} Phi^n(Bot) achieves stable homeostatic equilibrium"
  },
  "lyapunov_homeostasis": {
    "potential_function": "V(s) = w_cpu * (Load/Cores)^2 + w_mem * (UsedMem/TotalMem)^2 + w_port * PortContention + w_drift * (1 - EvoScore)",
    "weights": {
      "w_cpu": 0.35,
      "w_mem": 0.35,
      "w_port": 0.15,
      "w_drift": 0.15
    },
    "stability_criterion": "Delta V(s) = V(s_{t+1}) - V(s_t) <= 0",
    "drift_bands": {
      "nominal": "< 0.20",
      "minor": "0.20 - 0.45",
      "warning": "0.45 - 0.70",
      "critical": "> 0.70 (Triggers Prajna Circuit Breaker)"
    }
  },
