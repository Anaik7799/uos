[Unit]
Description=UOS Autonomous Intelligent Holon Node (Pure Erlang/OTP 29)
After=network.target network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=an
WorkingDirectory=/home/an/uos
ExecStart=/home/an/uos/run-holon.sh
Restart=always
RestartSec=5s
LimitNOFILE=65536
Environment=HOME=/home/an
Environment=ERL_CRASH_DUMP=/home/an/uos/erl_crash.dump

[Install]
WantedBy=multi-user.target
