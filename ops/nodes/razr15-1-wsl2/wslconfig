# ==============================================================================
# [C3I-SIL6-MSTS] Hardened Windows Host .wslconfig for razr15-1 (Instance 2)
# ==============================================================================
# Location on Windows Host: C:\Users\abhij\.wslconfig
# Allocates high-performance GPU, memory, and prevents VM idle termination
# ==============================================================================

[wsl2]
memory=12GB
processors=12
swap=8GB
localhostForwarding=true
nestedVirtualization=true
guiApplications=false
gpuSupport=true
pageReporting=true

# Prevent VM idle shutdown
vmIdleTimeout=-1

# Performance & Network Hardening
[experimental]
autoMemoryReclaim=gradual
sparseVhd=true
autoProxy=true
