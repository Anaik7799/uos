  "canonical_request_digest": {
    "algorithm": "sha256_hex",
    "format": "uos.telegram-store.apply.v1\\nbot:<bot_id>\\nop:<operation_id>\\ngen:<expected_generation>\\nread:<key>:<expected_version>:<expected_sha256>\\n(sorted by key ASC)...\\nchange:<key>:<expected_version>:<expected_sha256>:<new_value_base64>\\n(sorted by key ASC)...\\nres:<rows>:<receipts>\\nsummary:<summary_json>\\n",
    "rule": "Derived independently in native kernel from decoded parameters. req.request_digest must match derived digest exactly or returns request_digest_mismatch. Stored receipt holds derived digest; replaying different changes under same operation_id returns operation_collision_digest_mismatch."
  },
  "limits": {
