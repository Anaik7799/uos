//// Device filters and drill-down over authenticated observations.
pub fn script() -> String {
  "(() => {\n const grid=document.getElementById('mini-health-grid');if(!grid)return;\n const filter=document.getElementById('mini-health-filter'),detail=document.getElementById('mini-health-detail'),status=document.getElementById('mini-health-status');\n let devices=[],selected=null;\n const gradeNames={normal:'Within sensor threshold',warning:'Temperature warning',critical:'Critical temperature',unknown:'Health unassessed'};\n function value(d){if(d.reading===null)return 'Reading unavailable';if(d.unit==='milli_celsius')return (d.reading/1000).toFixed(2)+' °C';if(d.unit==='carrier')return 'Carrier: '+d.reading;return d.reading+' × 512-byte sectors';}\n function showDetail(){\n  detail.replaceChildren();const d=devices.find(x=>x.id===selected);if(!d)return;\n  const title=document.createElement('h3');title.textContent=d.label;detail.append(title);\n  const fields=[['Device',d.id],['Type',d.kind],['State',d.state],['Reading',value(d)],['Assessment',gradeNames[d.grade]]];\n  if(d.kind==='temperature')for(const [k,v] of [['High threshold',d.high],['Critical threshold',d.critical]])fields.push([k,v===null?(d.thresholds_valid?'Not provided':'Unavailable or invalid'):(v/1000).toFixed(2)+' °C']);\n  for(const [k,v] of fields){\n   const p=document.createElement('p');p.textContent=k+': '+v;detail.append(p);\n  }\n }\n function render(){\n  grid.replaceChildren();const shown=devices.filter(d=>filter.value==='all'||d.grade===filter.value);\n  for(const d of shown){\n   const button=document.createElement('button');button.type='button';button.className='tg-btn';button.style.cssText='text-align:left;white-space:normal;overflow-wrap:anywhere;margin:4px 0;width:100%';\n   button.dataset.device=d.id;button.dataset.grade=d.grade;button.setAttribute('aria-pressed',String(selected===d.id));\n   button.textContent=d.label+' — '+value(d)+' — '+gradeNames[d.grade];\n   button.addEventListener('click',()=>{selected=d.id;render();});grid.append(button);\n  }\n  status.textContent=shown.length+' of '+devices.length+' devices shown.';\n  if(!shown.some(d=>d.id===selected))selected=null;showDetail();\n }\n window.addEventListener('mini-observation-start',()=>{devices=[];selected=null;filter.disabled=true;grid.replaceChildren();detail.replaceChildren();status.textContent='No current device observation.';});\n window.addEventListener('mini-observed',e=>{\n  try{\n   const f=e.detail,count=f['Device count'];\n   if(typeof count!=='string'||!/^(0|[1-9][0-9]?)$/.test(count)||Number(count)>64)throw Error('count');\n   const entries=Object.entries(f).filter(([k])=>/^Device [0-9]+$/.test(k));\n   if(entries.length!==Number(count)||!Array.from({length:Number(count)},(_,i)=>'Device '+(i+1)).every(k=>Object.hasOwn(f,k)))throw Error('indices');\n   const rows=entries.map(([,v])=>JSON.parse(v));\n   if(new Set(rows.map(x=>x.id)).size!==rows.length)throw Error('duplicate');\n   for(const d of rows){\n    if(!d||!['id','label','state'].every(k=>typeof d[k]==='string'&&d[k].length>0&&d[k].length<=300)||!['temperature','network','block','sensor'].includes(d.kind)||!d.id.startsWith(d.kind+':')||!Object.hasOwn(gradeNames,d.grade)||typeof d.thresholds_valid!=='boolean'||![d.reading,d.high,d.critical].every(x=>x===null||Number.isSafeInteger(x)))throw Error('invalid device');\n    if(d.unit!==({temperature:'milli_celsius',network:'carrier',block:'512_byte_sectors',sensor:'none'})[d.kind])throw Error('unit');\n   }\n   rows.sort((a,b)=>a.id<b.id?-1:a.id>b.id?1:0);\n   devices=rows;filter.disabled=false;render();\n  }catch(_){devices=[];selected=null;filter.disabled=true;grid.replaceChildren();detail.replaceChildren();status.textContent='Device observation could not be validated.';}\n });\n filter.addEventListener('change',render);\n})();"
}
