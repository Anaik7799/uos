//// Logger control client: one explicit submission, receipt-only recovery.

pub fn script() -> String {
  "(() => {\n  const root=document.getElementById('mini-app'), apply=document.getElementById('mini-control-apply');\n  if(!root||!apply)return;\n  const select=document.getElementById('mini-control-level'), status=document.getElementById('mini-control-status');\n  const check=document.getElementById('mini-control-receipt'), reset=document.getElementById('mini-control-reset');\n  const key='uos-mini-logger-request-v1';\n  let observed=null, observedAt=0, pending=null, busy=false;\n  try { pending=JSON.parse(sessionStorage.getItem(key)||'null'); } catch(_) {}\n  if(pending && (!/^[a-f0-9]{32}$/.test(pending.request_id)||typeof pending.expected_level!=='string'||typeof pending.target_level!=='string'))pending=null;\n  function update() {\n    apply.disabled=busy||!!pending||!observed||Date.now()-observedAt>15000||select.value===observed;\n    check.disabled=busy||!pending; reset.disabled=busy||!pending||!observed||Date.now()-observedAt>15000;\n  }\n  function save() { try { if(pending)sessionStorage.setItem(key,JSON.stringify(pending));else sessionStorage.removeItem(key); }catch(_){} update(); }\n  if(pending)status.textContent='An earlier request needs a receipt check. It will not be sent again.';\n  window.addEventListener('mini-observation-start',()=>{observed=null;update();});\n  window.addEventListener('mini-observed',e=>{\n    const level=e.detail['VM logger level'];\n    observed=typeof level==='string'&&level!=='UNAVAILABLE'?level:null;observedAt=Date.now();update();\n  });\n  select.addEventListener('change',update);\n  async function send(receiptOnly) {\n    if(busy||!pending)return;\n    const tg=window.Telegram&&window.Telegram.WebApp;\n    if(!tg||!tg.initData){status.textContent='Open the bot again to authenticate.';return;}\n    busy=true;update();const abort=new AbortController(),timer=setTimeout(()=>abort.abort(),55000);\n    status.textContent=receiptOnly?'Checking the durable receipt…':'Applying the request once…';\n    try {\n      const response=await fetch(receiptOnly?'/mini-app/api/action-receipt':'/mini-app/api/action',{\n        method:'POST',headers:{'content-type':'application/json'},credentials:'omit',cache:'no-store',redirect:'error',\n        body:JSON.stringify({...pending,init_data:tg.initData,path:root.dataset.page,action:'set_vm_logger_level'}),signal:abort.signal});\n      const data=await response.json();\n      if(data.retryable!==false||typeof data.status!=='string')throw Error('invalid receipt');\n      let receipt=data.receipt;\n      if(typeof receipt==='string'){try{receipt=JSON.parse(receipt);}catch(_){receipt=null;}}\n      if(data.status==='applied'||data.status==='terminal_receipt') {\n        if(!receipt||!['applied','level_mismatch','identity_changed','fixture_clock_or_lease_expired','unauthorized'].includes(receipt.status)) {\n          status.textContent='The outcome is uncertain. Check the receipt and load current data before another request.';\n        } else {\n          status.textContent=receipt.status==='applied'?'Confirmed: '+receipt.prior_level+' → '+receipt.observed_level+'.':'No change: '+receipt.status+'. Load current data.';\n          pending=null;observed=null;save();\n        }\n      } else if(!receiptOnly && data.effects_this_request===0) {\n        status.textContent='No change: '+data.status+'. Load current data before another request.';\n        pending=null;observed=null;save();\n      } else {\n        status.textContent='Receipt: '+data.status+'. No automatic retry. Check the receipt and load current data.';\n      }\n    } catch(_) {\n      status.textContent='The request outcome is unknown. It will not be resent. Check its receipt and load current data.';\n    } finally {clearTimeout(timer);busy=false;update();}\n  }\n  apply.addEventListener('click',()=>{\n    update();if(apply.disabled)return;\n    if(!window.crypto||!window.crypto.getRandomValues){status.textContent='Secure request IDs are unavailable.';return;}\n    const bytes=crypto.getRandomValues(new Uint8Array(16));\n    pending={request_id:Array.from(bytes,b=>b.toString(16).padStart(2,'0')).join(''),expected_level:observed,target_level:select.value};\n    save();send(false);\n  });\n  check.addEventListener('click',()=>send(true));\n  reset.addEventListener('click',()=>{\n    update();if(reset.disabled)return;\n    if(window.confirm('The earlier request may have changed the level. The latest observed level is '+observed+'. Close that request and allow a new explicit change?')){\n      pending=null;save();status.textContent='Earlier request closed locally. Its durable receipt is retained.';\n    }\n  });\n  setInterval(update,1000);\n  update();\n})();"
}
