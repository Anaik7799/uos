//// Current conditions with explicit acknowledgement and receipt-only recovery.
pub fn script() -> String {
  "(() => {\n const root=document.getElementById('mini-app'),grid=document.getElementById('mini-alert-grid');if(!root||!grid)return;\n const filter=document.getElementById('mini-alert-filter'),detail=document.getElementById('mini-alert-detail'),status=document.getElementById('mini-alert-status');\n const all=document.getElementById('mini-alert-ack-all'),check=document.getElementById('mini-alert-receipt'),close=document.getElementById('mini-alert-close'),outcome=document.getElementById('mini-alert-outcome');\n const key='uos-mini-alert-request-v1',rank={critical:0,warning:1,unknown:2,advisory:3},hex64=x=>typeof x==='string'&&/^[a-f0-9]{64}$/.test(x);\n let rows=[],selected=null,context=null,observedAt=0,lastInstance=null,pending=null,busy=false;\n try{pending=JSON.parse(sessionStorage.getItem(key)||'null');lastInstance=sessionStorage.getItem(key+'-instance');if(!hex64(lastInstance))lastInstance=null;}catch(_){}\n if(pending&&(!['acknowledge_alert','acknowledge_all'].includes(pending.action)||!/^[a-f0-9]{32}$/.test(pending.request_id)||!hex64(pending.expected_episode_set)||!((pending.action==='acknowledge_all'&&pending.target_episode==='all')||(pending.action==='acknowledge_alert'&&hex64(pending.target_episode)))||typeof pending.user!=='string'))pending=null;\n function fresh(){return context&&performance.now()-observedAt<15000&&!document.hidden;}\n function enabled(){return !busy&&!pending&&fresh();}\n function update(){\n  all.disabled=!enabled()||!rows.some(r=>r.episode&&!r.review);\n  check.disabled=busy||!pending||!fresh()||pending.user!==context.user;\n  close.disabled=busy||!pending||!fresh();\n  for(const b of [all,check,close])b.style.opacity=b.disabled?'0.45':'1';\n  for(const b of detail.querySelectorAll('[data-ack]')){const r=rows.find(r=>r.episode===b.dataset.ack);b.disabled=!enabled()||!r||!!r.review;b.style.opacity=b.disabled?'0.45':'1';}\n }\n function save(){try{if(pending)sessionStorage.setItem(key,JSON.stringify(pending));else sessionStorage.removeItem(key);}catch(_){}update();}\n function render(){\n  grid.replaceChildren();detail.replaceChildren();\n  const shown=rows.filter(r=>filter.value==='all'||r.severity===filter.value);\n  if(!shown.some(r=>r.id===selected))selected=null;\n  for(const r of shown){\n   const button=document.createElement('button');button.type='button';button.className='tg-btn';\n   button.style.cssText='text-align:left;white-space:normal;overflow-wrap:anywhere;margin:4px 0;width:100%';\n   button.style.background=({critical:'#991b1b',warning:'#92400e',unknown:'#374151',advisory:'#1e3a8a'})[r.severity];button.style.color='#ffffff';\n   button.dataset.alert=r.id;button.dataset.severity=r.severity;button.setAttribute('aria-pressed',String(selected===r.id));\n   button.textContent=r.severity.toUpperCase()+' · '+r.source+' — '+r.condition+(r.review?' · Reviewed':'');\n   button.addEventListener('click',()=>{selected=r.id;render();});grid.append(button);\n  }\n  status.textContent=shown.length+' of '+rows.length+' conditions shown. Coverage gaps are not all-clear.';\n  const r=rows.find(r=>r.id===selected);\n  if(r){\n   for(const k of ['source','severity','condition','measured','threshold']){const p=document.createElement('p');p.style.overflowWrap='anywhere';p.textContent=k+': '+r[k];detail.append(p);}\n   const review=document.createElement('p');review.textContent=r.review?'Reviewed by user '+r.review.user+' at '+new Date(r.review.at*1000).toISOString()+'. Condition remains visible.':'Not acknowledged.';detail.append(review);\n   if(r.episode){const b=document.createElement('button');b.type='button';b.className='tg-btn';b.dataset.ack=r.episode;b.textContent=r.review?'Already acknowledged':'Acknowledge this alert';b.addEventListener('click',()=>submit('acknowledge_alert',r.episode));detail.append(b);}\n  }\n  update();\n }\n function clear(message){rows=[];selected=null;context=null;filter.disabled=true;grid.replaceChildren();detail.replaceChildren();status.textContent=message;update();}\n window.addEventListener('mini-observation-start',()=>clear('No current alert observation.'));\n window.addEventListener('mini-observed',e=>{\n  try{\n   const f=e.detail,count=f['Alert count'];\n   if(typeof count!=='string'||!/^(0|[1-9][0-9]?)$/.test(count)||Number(count)>80)throw Error('count');\n   const entries=Object.entries(f).filter(([k])=>/^Alert [0-9]+$/.test(k));\n   if(entries.length!==Number(count)||!Array.from({length:Number(count)},(_,i)=>'Alert '+(i+1)).every(k=>Object.hasOwn(f,k)))throw Error('indices');\n   const parsed=entries.map(([,v])=>JSON.parse(v)),controlled=hex64(f['Owner incarnation'])&&hex64(f['Episode set SHA256'])&&/^[1-9][0-9]*$/.test(f['Reader user']||'');\n   for(const r of parsed){\n    if(!r||Object.keys(r).length!==(controlled?8:6)||!['id','source','severity','condition','measured','threshold'].every(k=>typeof r[k]==='string'&&r[k].length>0&&r[k].length<=600)||!Object.hasOwn(rank,r.severity))throw Error('row');\n    if(controlled&&(!hex64(r.episode)||(r.review!==null&&(!r.review||Object.keys(r.review).length!==3||!Number.isSafeInteger(r.review.user)||r.review.user<=0||!Number.isSafeInteger(r.review.at)||r.review.at<=0||!/^mini-control\\/[a-f0-9]{64}$/.test(r.review.receipt)))))throw Error('review');\n   }\n   if(new Set(parsed.map(r=>r.id)).size!==parsed.length)throw Error('duplicates');\n   if(controlled){\n    if(lastInstance&&lastInstance!==f['Owner incarnation'])outcome.textContent='The alert observer restarted. Active acknowledgements require review again; historical receipts remain.'+(pending?' The earlier request still needs a receipt check and will not be resent.':'');\n    lastInstance=f['Owner incarnation'];try{sessionStorage.setItem(key+'-instance',lastInstance);}catch(_){}context={user:f['Reader user'],set:f['Episode set SHA256'],instance:lastInstance};observedAt=performance.now();\n   }else context=null;\n   parsed.sort((a,b)=>rank[a.severity]-rank[b.severity]||(a.id<b.id?-1:a.id>b.id?1:0));\n   rows=parsed;filter.disabled=false;render();\n   if(!pending)outcome.textContent=outcome.textContent.replace('Refresh required to verify current conditions.','Current conditions refreshed.').replace('Refresh before another request.','Current conditions refreshed.');\n  }catch(_){clear('Alert observation could not be validated.');}\n });\n async function send(receiptOnly){\n  if(busy||!pending||!fresh()||pending.user!==context.user)return;\n  const tg=window.Telegram&&window.Telegram.WebApp;if(!tg||!tg.initData)return;\n  busy=true;update();const abort=new AbortController(),timer=setTimeout(()=>abort.abort(),55000);\n  outcome.textContent=receiptOnly?'Checking the durable acknowledgement receipt…':'Recording acknowledgement once…';\n  try{\n   const {user,...request}=pending;\n   const response=await fetch(receiptOnly?'/mini-app/api/action-receipt':'/mini-app/api/action',{method:'POST',headers:{'content-type':'application/json'},credentials:'omit',cache:'no-store',redirect:'error',body:JSON.stringify({...request,init_data:tg.initData,path:root.dataset.page}),signal:abort.signal});\n   const d=await response.json();if(d.retryable!==false||typeof d.status!=='string')throw Error('receipt');\n   let r=d.receipt;if(typeof r==='string'){try{r=JSON.parse(r);}catch(_){r=null;}}\n   if(d.status==='alerts_acknowledged'||(d.status==='terminal_receipt'&&r&&r.status==='alerts_acknowledged')){\n    let at=r&&r.at;if(r&&typeof r.native_receipt==='string'){try{const native=JSON.parse(r.native_receipt);at=native.at;}catch(_){at=undefined;}}\n    outcome.textContent='Acknowledgement recorded: '+pending.request_id+(Number.isSafeInteger(at)?' at '+new Date(at*1000).toISOString():'')+'. Source conditions remain unchanged. Refresh required to verify current conditions.';\n    pending=null;save();clear('Awaiting a new observation after acknowledgement.');document.getElementById('mini-refresh').click();\n   }else if(d.status==='terminal_receipt'&&r&&r.effect_count===0){\n    outcome.textContent='No acknowledgement: '+r.status+'. Current observations remain available.';pending=null;save();\n   }else if(!receiptOnly&&d.effects_this_request===0){\n    outcome.textContent='No acknowledgement: '+d.status+'. Refresh before another request.';pending=null;save();clear('Load current data before another action.');\n   }else{\n    outcome.textContent=receiptOnly?'Receipt: '+d.status+'. No automatic retry. Inspect current observations and close the local recovery prompt when ready.':'Outcome: '+d.status+'. No automatic retry. Load current data and check the receipt.';\n    if(!receiptOnly)clear('Acknowledgement outcome is unverified; current observations must be reloaded.');\n   }\n  }catch(_){outcome.textContent='Acknowledgement outcome unknown. The request will not be resent. Load current data and check its receipt.';if(!receiptOnly)clear('Current alert review state is unverified.');}\n  finally{clearTimeout(timer);busy=false;update();}\n }\n function submit(action,target){\n  update();if(!enabled()||!window.crypto||!crypto.getRandomValues)return;\n  if(action==='acknowledge_alert'&&!rows.some(r=>r.episode===target&&!r.review))return;\n  if(!window.confirm(action==='acknowledge_all'?'Acknowledge all current unreviewed alerts, including those hidden by the severity filter? Conditions will remain visible.':'Record that you reviewed this alert? Its condition will remain visible.'))return;\n  pending={action,request_id:Array.from(crypto.getRandomValues(new Uint8Array(16)),b=>b.toString(16).padStart(2,'0')).join(''),expected_episode_set:context.set,target_episode:target,user:context.user};save();send(false);\n }\n all.addEventListener('click',()=>{update();if(!all.disabled)submit('acknowledge_all','all');});\n check.addEventListener('click',()=>send(true));\n close.addEventListener('click',()=>{update();if(close.disabled)return;if(window.confirm('Close this local recovery prompt after inspecting the receipt and current observations? The durable receipt will remain.')){pending=null;save();outcome.textContent='Local recovery prompt closed; historical receipts remain.';}});\n filter.addEventListener('change',render);\n document.addEventListener('visibilitychange',()=>{if(document.hidden)clear('Page inactive; refresh before acknowledgement.');});\n if(pending)outcome.textContent='An earlier acknowledgement needs a receipt check. It will not be resent.';\n setInterval(update,1000);update();\n})();"
}
