//// Severity filtering and details for authenticated alert observations.
pub fn script() -> String {
  "(() => {\n const grid=document.getElementById('mini-alert-grid');if(!grid)return;\n const filter=document.getElementById('mini-alert-filter'),detail=document.getElementById('mini-alert-detail'),status=document.getElementById('mini-alert-status');\n let rows=[],selected=null;\n const rank={critical:0,warning:1,unknown:2,advisory:3};\n function render(){\n  grid.replaceChildren();detail.replaceChildren();\n  const shown=rows.filter(r=>filter.value==='all'||r.severity===filter.value);\n  if(!shown.some(r=>r.id===selected))selected=null;\n  for(const r of shown){\n   const button=document.createElement('button');button.type='button';button.className='tg-btn';\n   button.style.cssText='text-align:left;white-space:normal;overflow-wrap:anywhere;margin:4px 0;width:100%';\n   button.style.background=({critical:'#991b1b',warning:'#92400e',unknown:'#374151',advisory:'#1e3a8a'})[r.severity];button.style.color='#ffffff';\n   button.dataset.alert=r.id;button.dataset.severity=r.severity;button.setAttribute('aria-pressed',String(selected===r.id));\n   button.textContent=r.severity.toUpperCase()+' · '+r.source+' — '+r.condition;\n   button.addEventListener('click',()=>{selected=r.id;render();});grid.append(button);\n  }\n  status.textContent=shown.length+' of '+rows.length+' conditions shown. Coverage gaps are not all-clear.';\n  const r=rows.find(r=>r.id===selected);if(r)for(const [key,value] of Object.entries(r)){\n   const p=document.createElement('p');p.style.overflowWrap='anywhere';p.textContent=key+': '+value;detail.append(p);\n  }\n }\n function clear(message){rows=[];selected=null;filter.disabled=true;grid.replaceChildren();detail.replaceChildren();status.textContent=message;}\n window.addEventListener('mini-observation-start',()=>clear('No current alert observation.'));\n window.addEventListener('mini-observed',e=>{\n  try{\n   const f=e.detail,count=f['Alert count'];\n   if(typeof count!=='string'||!/^(0|[1-9][0-9]?)$/.test(count)||Number(count)>80)throw Error('count');\n   const entries=Object.entries(f).filter(([k])=>/^Alert [0-9]+$/.test(k));\n   if(entries.length!==Number(count)||!Array.from({length:Number(count)},(_,i)=>'Alert '+(i+1)).every(k=>Object.hasOwn(f,k)))throw Error('indices');\n   const parsed=entries.map(([,v])=>JSON.parse(v));\n   for(const r of parsed){\n    if(!r||Object.keys(r).length!==6||!['id','source','severity','condition','measured','threshold'].every(k=>typeof r[k]==='string'&&r[k].length>0&&r[k].length<=600)||!Object.hasOwn(rank,r.severity))throw Error('row');\n   }\n   if(new Set(parsed.map(r=>r.id)).size!==parsed.length)throw Error('duplicates');\n   parsed.sort((a,b)=>rank[a.severity]-rank[b.severity]||(a.id<b.id?-1:a.id>b.id?1:0));\n   rows=parsed;filter.disabled=false;render();\n  }catch(_){clear('Alert observation could not be validated.');}\n });\n filter.addEventListener('change',render);\n})();"
}
