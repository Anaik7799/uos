//// One-shot chat send and explicit receipt/closure recovery.
pub fn script() -> String {
  "(() => {\n const root=document.getElementById('mini-app'),input=document.getElementById('mini-chat-prompt');\n if(!root||!input)return;\n const send=document.getElementById('mini-chat-send'),check=document.getElementById('mini-chat-receipt'),\n abandon=document.getElementById('mini-chat-abandon'),close=document.getElementById('mini-chat-close'),status=document.getElementById('mini-chat-status'),reply=document.getElementById('mini-chat-reply');\n const key='uos-mini-chat-request-v1';\n let observed=null,at=0,busy=false,pending=null;\n const bytes=s=>new TextEncoder().encode(s).length;\n try{pending=JSON.parse(sessionStorage.getItem(key)||'null');}catch(_){}\n if(pending&&(!/^[a-f0-9]{32}$/.test(pending.request_id)||typeof pending.prompt!=='string'||bytes(pending.prompt)>4096||!pending.prompt.trim()||!Number.isSafeInteger(pending.expected_version)||pending.expected_version<0||typeof pending.expected_sha256!=='string'||typeof pending.identity!=='string'))pending=null;\n const fresh=()=>observed&&Date.now()-at<15000;\n function update(){send.disabled=busy||!!pending||!fresh()||!input.value.trim()||bytes(input.value)>4096;input.disabled=busy||!!pending;check.disabled=busy||!pending||!fresh()||pending.identity!==observed.identity;abandon.disabled=check.disabled;close.disabled=busy||!pending;}\n function save(){try{if(pending)sessionStorage.setItem(key,JSON.stringify(pending));else sessionStorage.removeItem(key);}catch(_){}update();}\n if(pending)status.textContent='An earlier send needs a receipt check. It will not be sent again.';\n window.addEventListener('mini-observation-start',()=>{observed=null;update();});\n window.addEventListener('mini-observed',e=>{\n   const f=e.detail,v=Number(f['Context version']),sha=f['Context SHA256'];\n   observed=Number.isSafeInteger(v)&&v>=0&&typeof sha==='string'&&((v===0&&sha==='')||(v>0&&/^[a-f0-9]{64}$/.test(sha)))?{version:v,sha,identity:JSON.stringify([f.Bot,f.Chat,f.User])}:null;\n   at=Date.now();update();\n });\n async function request(receiptOnly,abandonRequest=false){\n  if(busy||!pending||!fresh()||pending.identity!==observed.identity)return;\n  const tg=window.Telegram&&window.Telegram.WebApp;if(!tg||!tg.initData)return;\n  busy=true;update();status.textContent=receiptOnly?'Checking saved result…':'Sending once…';\n  const abort=new AbortController(),timer=setTimeout(()=>abort.abort(),55000);\n  try{\n   const body={init_data:tg.initData,path:root.dataset.page,action:abandonRequest?'abandon_message':'send_message',request_id:pending.request_id,prompt:pending.prompt,expected_version:pending.expected_version,expected_sha256:pending.expected_sha256};\n   const res=await fetch(receiptOnly?'/mini-app/api/action-receipt':'/mini-app/api/action',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body),credentials:'omit',cache:'no-store',redirect:'error',signal:abort.signal});\n   const d=await res.json();if(d.retryable!==false||typeof d.status!=='string')throw Error('invalid response');\n   let r=d.receipt;if(typeof r==='string')r=JSON.parse(r);\n   let n=r&&r.native_receipt;if(typeof n==='string')n=JSON.parse(n);\n   if((d.status==='applied'||d.status==='terminal_receipt')&&r&&r.status==='chat_terminal'&&n&&n.request_id===pending.request_id&&n.context_version===pending.expected_version&&n.context_sha256===pending.expected_sha256&&['completed','model_failed','context_changed','abandoned'].includes(n.status)){\n     if(n.status==='completed'&&typeof n.reply==='string'){reply.textContent=n.reply;status.textContent='Reply saved. Load current data before another send.';}\n     else if(n.status==='abandoned'){status.textContent='Pending request closed locally. The provider may have received it; quota is retained. Late replies cannot be added.';}\n     else if(n.status==='context_changed'){status.textContent='Context changed during the request; no reply was added. Load current data.';}\n     else{status.textContent='No usable reply was saved. The provider may have received the request. It will not be retried.';}\n     pending=null;input.value='';observed=null;save();\n   }else if(!receiptOnly&&!abandonRequest&&d.effects_this_request===0){\n     status.textContent='Send refused: '+d.status+'. Load current data.';pending=null;observed=null;save();\n   }else{status.textContent='Outcome: '+d.status+'. No automatic retry. Load current data and check the receipt.';}\n  }catch(_){status.textContent='Outcome unknown. No automatic retry. Load current data and check the receipt.';}\n  finally{clearTimeout(timer);busy=false;update();}\n }\n send.addEventListener('click',()=>{update();if(send.disabled||!crypto.getRandomValues)return;\n   pending={request_id:Array.from(crypto.getRandomValues(new Uint8Array(16)),b=>b.toString(16).padStart(2,'0')).join(''),prompt:input.value,expected_version:observed.version,expected_sha256:observed.sha,identity:observed.identity};\n   save();request(false);\n });\n check.addEventListener('click',()=>request(true));\n abandon.addEventListener('click',()=>{update();if(abandon.disabled)return;if(confirm('Close the pending request and prevent a late reply from being saved? The provider may already have received it. This does not cancel remote work or refund quota.'))request(false,true);});\n close.addEventListener('click',()=>{if(busy||!pending)return;if(confirm('The provider may have processed this request. Close only this local recovery prompt? This does not cancel the request or refund quota.')){pending=null;save();status.textContent='Local prompt closed. Durable records remain; a new send is a separate request.';}});\n input.addEventListener('input',update);setInterval(update,1000);update();\n})();"
}
