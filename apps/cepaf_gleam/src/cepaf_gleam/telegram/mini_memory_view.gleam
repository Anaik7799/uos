//// Explicit clear/reset with receipt-only recovery and observed identity binding.
pub fn script() -> String {
  "(() => {\n  const root=document.getElementById('mini-app'), clear=document.getElementById('mini-memory-clear');\n  if(!root||!clear)return;\n  const reset=document.getElementById('mini-memory-reset'),check=document.getElementById('mini-memory-receipt'),close=document.getElementById('mini-memory-close'),status=document.getElementById('mini-memory-status');\n  const key='uos-mini-memory-request-v1';\n  let observed=null,observedAt=0,pending=null,busy=false;\n  try {pending=JSON.parse(sessionStorage.getItem(key)||'null');}catch(_){}\n  if(pending&&(!/^[a-f0-9]{32}$/.test(pending.request_id)||!['clear_history','reset_history'].includes(pending.action)||!Number.isSafeInteger(pending.expected_version)||pending.expected_version<0||typeof pending.expected_sha256!=='string'||typeof pending.identity!=='string'))pending=null;\n  function fresh(){return observed&&Date.now()-observedAt<15000;}\n  function update(){clear.disabled=reset.disabled=busy||!!pending||!fresh();check.disabled=busy||!pending||!fresh()||pending.identity!==observed.identity;close.disabled=busy||!pending||!fresh();}\n  function save(){try{if(pending)sessionStorage.setItem(key,JSON.stringify(pending));else sessionStorage.removeItem(key);}catch(_){}update();}\n  if(pending)status.textContent='An earlier request needs a receipt check. It will not be sent again.';\n  window.addEventListener('mini-observation-start',()=>{observed=null;update();});\n  window.addEventListener('mini-observed',e=>{\n    const f=e.detail,v=Number(f['Context version']),sha=f['Context SHA256'];\n    observed=Number.isSafeInteger(v)&&v>=0&&typeof sha==='string'&&((v===0&&sha==='')||(v>0&&/^[a-f0-9]{64}$/.test(sha)))?\n      {version:v,sha,identity:JSON.stringify([f.Bot,f.Chat,f.User])}:null;\n    observedAt=Date.now();update();\n  });\n  async function send(receiptOnly){\n    if(busy||!pending||!fresh()||pending.identity!==observed.identity)return;\n    const tg=window.Telegram&&window.Telegram.WebApp;if(!tg||!tg.initData)return;\n    busy=true;update();const abort=new AbortController(),timer=setTimeout(()=>abort.abort(),55000);\n    status.textContent=receiptOnly?'Checking the durable receipt…':'Clearing retained context once…';\n    try{\n      const body={init_data:tg.initData,path:root.dataset.page,action:pending.action,request_id:pending.request_id,expected_version:pending.expected_version,expected_sha256:pending.expected_sha256};\n      const response=await fetch(receiptOnly?'/mini-app/api/action-receipt':'/mini-app/api/action',{method:'POST',headers:{'content-type':'application/json'},credentials:'omit',cache:'no-store',redirect:'error',body:JSON.stringify(body),signal:abort.signal});\n      const d=await response.json();if(d.retryable!==false||typeof d.status!=='string')throw Error('invalid receipt');\n      let r=d.receipt;if(typeof r==='string'){try{r=JSON.parse(r);}catch(_){r=null;}}\n      if((d.status==='applied'||d.status==='terminal_receipt')&&r&&r.status==='history_cleared'){\n        status.textContent='Confirmed: retained conversation context cleared. Load current data.';pending=null;observed=null;save();\n      }else if(!receiptOnly&&d.effects_this_request===0){\n        status.textContent='No change: '+d.status+'. Load current data.';pending=null;observed=null;save();\n      }else{status.textContent='Outcome: '+d.status+'. No automatic retry. Load current data and check the receipt.';}\n    }catch(_){status.textContent='The outcome is unknown. It will not be resent. Load current data and check the receipt.';}\n    finally{clearTimeout(timer);busy=false;update();}\n  }\n  function submit(action){\n    update();if(clear.disabled||!window.crypto||!crypto.getRandomValues)return;\n    if(!window.confirm('Clear retained context for this conversation? Telegram messages and quota usage stay unchanged.'))return;\n    pending={action,request_id:Array.from(crypto.getRandomValues(new Uint8Array(16)),b=>b.toString(16).padStart(2,'0')).join(''),expected_version:observed.version,expected_sha256:observed.sha,identity:observed.identity};\n    save();send(false);\n  }\n  clear.addEventListener('click',()=>submit('clear_history'));\n  reset.addEventListener('click',()=>submit('reset_history'));\n  check.addEventListener('click',()=>send(true));\n  close.addEventListener('click',()=>{update();if(close.disabled)return;if(window.confirm('The earlier request may have cleared context. Close its local recovery prompt after checking current data?')){pending=null;save();status.textContent='Recovery prompt closed locally; durable receipts remain.';}});\n  setInterval(update,1000);update();\n})();"
}
