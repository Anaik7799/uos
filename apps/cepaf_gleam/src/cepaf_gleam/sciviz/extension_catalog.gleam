//// Derived directly from https://exts.ggplot2.tidyverse.org/gallery/

import gleam/list

pub type ExtensionCategory {
  UncertaintyDistribution
  NetworkGraphTopology
  FlowAlluvialSankey
  HierarchicalPartition
  SpatialVectorField
  QualityControlTimeSeries
  BioinformaticsGenomics
  TypographyTextRepel
  MultiScaleCoordinate
  CompositeMultiPanel
  ThreeDimensionalProjection
  StatisticalDiagnosisInference
  PatternFilterShader
  DimensionalityReduction
  ThemingPaletteAesthetic
  IntrospectionLayerEditing
}

pub type ExtensionMetadata {
  ExtensionMetadata(
    name: String,
    url: String,
    author: String,
    description: String,
    tags: List(String),
    category: ExtensionCategory,
  )
}

pub fn category_to_string(c: ExtensionCategory) -> String {
  case c {
    UncertaintyDistribution -> "Uncertainty & Distribution"
    NetworkGraphTopology -> "Network & Graph Topology"
    FlowAlluvialSankey -> "Flow, Alluvial & Sankey"
    HierarchicalPartition -> "Hierarchical Partition"
    SpatialVectorField -> "Spatial & Vector Field"
    QualityControlTimeSeries -> "Quality Control & Time-Series"
    BioinformaticsGenomics -> "Bioinformatics & Genomics"
    TypographyTextRepel -> "Typography & Text Repel"
    MultiScaleCoordinate -> "Multi-Scale & Coordinates"
    CompositeMultiPanel -> "Composite & Multi-Panel"
    ThreeDimensionalProjection -> "3D & Perspective Projection"
    StatisticalDiagnosisInference -> "Statistical Diagnosis & Inference"
    PatternFilterShader -> "Pattern, Filter & Shaders"
    DimensionalityReduction -> "Dimensionality Reduction"
    ThemingPaletteAesthetic -> "Theming, Palettes & Aesthetics"
    IntrospectionLayerEditing -> "Introspection & Layer Editing"
  }
}

