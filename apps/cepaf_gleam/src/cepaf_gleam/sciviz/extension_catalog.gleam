pub fn count_by_category() -> List(#(ExtensionCategory, Int)) {
  let all = all_167_extensions()
  [
    #(UncertaintyDistribution, count_cat(all, UncertaintyDistribution)),
    #(NetworkGraphTopology, count_cat(all, NetworkGraphTopology)),
    #(FlowAlluvialSankey, count_cat(all, FlowAlluvialSankey)),
    #(HierarchicalPartition, count_cat(all, HierarchicalPartition)),
    #(SpatialVectorField, count_cat(all, SpatialVectorField)),
    #(QualityControlTimeSeries, count_cat(all, QualityControlTimeSeries)),
    #(BioinformaticsGenomics, count_cat(all, BioinformaticsGenomics)),
    #(TypographyTextRepel, count_cat(all, TypographyTextRepel)),
    #(MultiScaleCoordinate, count_cat(all, MultiScaleCoordinate)),
    #(CompositeMultiPanel, count_cat(all, CompositeMultiPanel)),
    #(ThreeDimensionalProjection, count_cat(all, ThreeDimensionalProjection)),
    #(StatisticalDiagnosisInference, count_cat(all, StatisticalDiagnosisInference)),
    #(PatternFilterShader, count_cat(all, PatternFilterShader)),
    #(DimensionalityReduction, count_cat(all, DimensionalityReduction)),
    #(ThemingPaletteAesthetic, count_cat(all, ThemingPaletteAesthetic)),
    #(IntrospectionLayerEditing, count_cat(all, IntrospectionLayerEditing)),
  ]
}

fn count_cat(items: List(ExtensionMetadata), target: ExtensionCategory) -> Int {
  list.filter(items, fn(m) { m.category == target })
  |> list.length
}
